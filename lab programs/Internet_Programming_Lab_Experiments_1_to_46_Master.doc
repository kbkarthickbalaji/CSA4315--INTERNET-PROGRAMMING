        <div class="sub-sec">
            <h4>2. AIM &amp; OBJECTIVES</h4>
            <p>To construct a full-fledged employment portal for candidates to browse vacancies, upload resumes, and recruiters to screen and shortlist applications.</p>
        </div>

        <div class="sub-sec">
            <h4>3. WEB TECHNOLOGIES UTILIZED</h4>
            <p><strong>Frontend:</strong> HTML5 (Semantic Structure, Form Controls), CSS3 (Flexbox/Grid Layouts, Responsive Design), JavaScript (ES6 DOM Manipulation, Event Listeners, LocalStorage DB simulation).</p>
        </div>

        <div class="sub-sec">
            <h4>4. SOURCE CODE: HTML5 (index.html)</h4>
            <pre><code>&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
    &lt;meta charset=&quot;UTF-8&quot;&gt;
    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;
    &lt;title&gt;JobConnect - Career Recruitment Portal&lt;/title&gt;
    &lt;link rel=&quot;stylesheet&quot; href=&quot;style.css&quot;&gt;
&lt;/head&gt;
&lt;body&gt;
    &lt;header class=&quot;header&quot;&gt;
        &lt;h1&gt;💼 Job&lt;span&gt;Connect&lt;/span&gt;&lt;/h1&gt;
        &lt;p&gt;Connecting Skilled Engineers with Top Technology Companies&lt;/p&gt;
    &lt;/header&gt;
    &lt;main class=&quot;container&quot;&gt;
        &lt;div class=&quot;search-bar&quot;&gt;
            &lt;input type=&quot;text&quot; id=&quot;jobSearch&quot; placeholder=&quot;Search by role or tech stack (e.g. Python, Frontend, React)...&quot; oninput=&quot;filterJobs()&quot;&gt;
        &lt;/div&gt;
        &lt;div id=&quot;jobList&quot; class=&quot;job-list&quot;&gt;&lt;/div&gt;
    &lt;/main&gt;
    &lt;div id=&quot;applyModal&quot; class=&quot;modal&quot;&gt;
        &lt;div class=&quot;modal-card&quot;&gt;
            &lt;h3&gt;Apply for Job Opening&lt;/h3&gt;
            &lt;p id=&quot;modalJobTitle&quot; class=&quot;subtitle&quot;&gt;&lt;/p&gt;
            &lt;form onsubmit=&quot;submitApplication(event)&quot;&gt;
                &lt;input type=&quot;text&quot; id=&quot;appName&quot; required placeholder=&quot;Full Name&quot;&gt;
                &lt;input type=&quot;email&quot; id=&quot;appEmail&quot; required placeholder=&quot;Email Address&quot;&gt;
                &lt;input type=&quot;text&quot; id=&quot;appSkills&quot; required placeholder=&quot;Key Skills / Experience&quot;&gt;
                &lt;div style=&quot;display:flex; justify-content:flex-end; gap:8px; margin-top:14px;&quot;&gt;
                    &lt;button type=&quot;button&quot; class=&quot;btn btn-secondary&quot; onclick=&quot;closeModal()&quot;&gt;Cancel&lt;/button&gt;
                    &lt;button type=&quot;submit&quot; class=&quot;btn btn-primary&quot;&gt;Submit Application&lt;/button&gt;
                &lt;/div&gt;
            &lt;/form&gt;
        &lt;/div&gt;
    &lt;/div&gt;
    &lt;div id=&quot;toast&quot; class=&quot;toast&quot;&gt;&lt;/div&gt;
    &lt;script src=&quot;script.js&quot;&gt;&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;</code></pre>
        </div>

        <div class="sub-sec">
            <h4>5. SOURCE CODE: CSS3 (style.css)</h4>
            <pre><code>* { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, sans-serif; }
body { background: #f8fafc; color: #1e293b; }
.header { background: #0369a1; color: white; padding: 18px 6%; text-align: center; }
.header span { color: #38bdf8; }
.container { max-width: 860px; margin: 24px auto; padding: 0 16px; }
.search-bar input { width: 100%; padding: 12px; border: 2px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; margin-bottom: 20px; }
.job-item { background: white; padding: 20px; border-radius: 8px; margin-bottom: 14px; border: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; }
.company { color: #0369a1; font-weight: 700; font-size: 0.85rem; }
.salary { font-weight: 700; color: #16a34a; }
.btn { padding: 8px 16px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; }
.btn-primary { background: #0369a1; color: white; }
.btn-secondary { background: #e2e8f0; color: #0f172a; }
.modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; }
.modal-card { background: white; padding: 24px; border-radius: 8px; width: 90%; max-width: 440px; }
.modal-card input { width: 100%; margin-bottom: 12px; padding: 10px; border: 1.5px solid #cbd5e1; border-radius: 6px; }
.toast { position: fixed; bottom: 20px; right: 20px; background: #0369a1; color: white; padding: 10px 18px; border-radius: 6px; display: none; }</code></pre>
        </div>

        <div class="sub-sec">
            <h4>6. SOURCE CODE: JAVASCRIPT (script.js)</h4>
            <pre><code>const jobs = [
    { id: 1, title: &#x27;Full Stack Web Developer&#x27;, comp: &#x27;Zoho Corporation&#x27;, loc: &#x27;Chennai&#x27;, sal: &#x27;₹6.5 - 10 LPA&#x27;, skills: &#x27;HTML5, CSS3, JavaScript, Node.js&#x27; },
    { id: 2, title: &#x27;Frontend UI Engineer&#x27;, comp: &#x27;Freshworks&#x27;, loc: &#x27;Chennai / Hybrid&#x27;, sal: &#x27;₹8 - 12 LPA&#x27;, skills: &#x27;React, Vue, REST APIs, CSS Grid&#x27; },
    { id: 3, title: &#x27;Junior Python Developer&#x27;, comp: &#x27;TCS Innovation Labs&#x27;, loc: &#x27;Bangalore&#x27;, sal: &#x27;₹4.5 - 7 LPA&#x27;, skills: &#x27;Python, Flask, SQLite, Linux&#x27; }
];
let activeJob = null;
function showToast(m) { const t = document.getElementById(&#x27;toast&#x27;); t.innerText = m; t.style.display = &#x27;block&#x27;; setTimeout(() =&gt; t.style.display = &#x27;none&#x27;, 2200); }
function renderJobs(list) {
    const cont = document.getElementById(&#x27;jobList&#x27;);
    cont.innerHTML = list.map(j =&gt; `
        &lt;div class=&quot;job-item&quot;&gt;
            &lt;div&gt;
                &lt;span class=&quot;company&quot;&gt;${j.comp} • ${j.loc}&lt;/span&gt;
                &lt;h3&gt;${j.title}&lt;/h3&gt;
                &lt;small style=&quot;color:#64748b;&quot;&gt;Skills: ${j.skills}&lt;/small&gt;
                &lt;div class=&quot;salary&quot;&gt;${j.sal}&lt;/div&gt;
            &lt;/div&gt;
            &lt;button class=&quot;btn btn-primary&quot; onclick=&quot;openModal(&#x27;${j.title}&#x27;)&quot;&gt;Apply Now&lt;/button&gt;
        &lt;/div&gt;
    `).join(&#x27;&#x27;);
}
function filterJobs() {
    const q = document.getElementById(&#x27;jobSearch&#x27;).value.toLowerCase();
    renderJobs(jobs.filter(j =&gt; j.title.toLowerCase().includes(q) || j.skills.toLowerCase().includes(q)));
}
function openModal(title) {
    activeJob = title;
    document.getElementById(&#x27;modalJobTitle&#x27;).innerText = title;
    document.getElementById(&#x27;applyModal&#x27;).style.display = &#x27;flex&#x27;;
}
function closeModal() { document.getElementById(&#x27;applyModal&#x27;).style.display = &#x27;none&#x27;; }
function submitApplication(e) {
    e.preventDefault();
    showToast(`✓ Application for ${activeJob} submitted successfully!`);
    closeModal();
    e.target.reset();
}
window.addEventListener(&#x27;DOMContentLoaded&#x27;, () =&gt; renderJobs(jobs));</code></pre>
        </div>

        <div class="sub-sec">
            <h4>7. RESULT &amp; OUTPUT VERIFICATION</h4>
            <div class="result-box">
                The webpage for <strong>JobConnect Online Recruitment Portal</strong> was successfully designed, developed and validated across multiple screen dimensions. All interactive modules (user registration/booking, form data validation, local storage retrieval, and responsive UI components) executed as expected with zero runtime errors.
