    <section id="exp_8" class="exp-section">
        <div class="exp-header">
            <h2>EXPERIMENT 8: MEDCARE HOSPITAL APPOINTMENT BOOKING</h2>
        </div>

        <div class="sub-sec">
            <h4>1. PROBLEM STATEMENT (QUESTION)</h4>
            <div class="question-box">8. In an effort to streamline the appointment process and enhance patient experience, 

MedCare Hospital has developed an online appointment booking system. This platform 

allows patients to book appointments with doctors from various specialties at their 

convenience. Key functionalities include user registration and login, browsing available 

doctors and appointment slots, booking and canceling appointments, and receiving 

appointment reminders via email or SMS. Patients can also view their appointment 

history and update their personal details. The system ensures data security and 


compliance with healthcare regulations to protect patient information. This online service 

aims to reduce wait times, minimize paperwork, and provide a seamless experience for 

patients and healthcare providers alike. This website helps the patient to search any 

hospital and book appointments as they prefer.

• Search Module

• Appointment Booking

• Check-in form Submitting

• Appointment management

• Schedule a timing

• Past appointment Management

Admin Features

• Manage appointments

• Manage doctors

• View Appointments statistics

• Rating Details

Patient Features

• Signup/Login.

• Can choose and book an appointment at the flexible time and date.

• Can search for doctor according to specialty and location.

• Can write reviews about the doctor and can select doctors according to otheruser

feedback.

• Can access all previous check-in details and medical past appointment

User

• User Registration

• User Login

• Search Location wise

• View Hosptial list

• Book Appointment

• View status

• View google map for single hospital

Hospital

• Hospital Registration

• Hosptial login

• Create hostpital details

• Update details

• Update location</div>
        </div>

        <div class="sub-sec">
            <h4>2. AIM &amp; OBJECTIVES</h4>
            <p>To design, develop and test a responsive web-based medcare hospital appointment booking utilizing HTML5, CSS3, and JavaScript.</p>
        </div>

        <div class="sub-sec">
            <h4>3. WEB TECHNOLOGIES UTILIZED</h4>
            <p><strong>Frontend:</strong> HTML5 (Semantic Structure, Form Controls), CSS3 (Flexbox/Grid Layouts, Responsive Design), JavaScript (ES6 DOM Manipulation, Event Listeners, LocalStorage DB simulation).</p>
        </div>

        <div class="sub-sec">
            <h4>4. SOURCE CODE: HTML5 (index.html)</h4>
            <pre><code>&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset=utf-8&gt;&lt;meta name=viewport content=&quot;width=device-width,initial-scale=1&quot;&gt;&lt;link rel=stylesheet href=../style.css&gt;&lt;/head&gt;&lt;body&gt;&lt;script src=../common.js&gt;&lt;/script&gt;&lt;script&gt;
const D=Store(&#x27;mc:doctors&#x27;,[
{name:&#x27;Dr. Anitha Rao&#x27;,specialty:&#x27;Cardiology&#x27;,hospital:&#x27;MedCare Central&#x27;,location:&#x27;Chennai&#x27;,fee:600},
{name:&#x27;Dr. Karthik Raman&#x27;,specialty:&#x27;Orthopedics&#x27;,hospital:&#x27;MedCare Central&#x27;,location:&#x27;Chennai&#x27;,fee:500},
{name:&#x27;Dr. Meera Nair&#x27;,specialty:&#x27;Pediatrics&#x27;,hospital:&#x27;MedCare Kids&#x27;,location:&#x27;Coimbatore&#x27;,fee:400},
{name:&#x27;Dr. Suresh Babu&#x27;,specialty:&#x27;Dermatology&#x27;,hospital:&#x27;MedCare Skin Clinic&#x27;,location:&#x27;Madurai&#x27;,fee:450}]);
const A=Store(&#x27;mc:appts&#x27;,[]);const SLOTS=[&#x27;09:00&#x27;,&#x27;10:00&#x27;,&#x27;11:00&#x27;,&#x27;12:00&#x27;,&#x27;14:00&#x27;,&#x27;15:00&#x27;,&#x27;16:00&#x27;];
let U,F={};
const rating=id=&gt;{const r=A.all().filter(a=&gt;a.docId==id&amp;&amp;a.rating);return r.length?(r.reduce((s,a)=&gt;s+a.rating,0)/r.length).toFixed(1)+&#x27;★ (&#x27;+r.length+&#x27;)&#x27;:&#x27;No ratings&#x27;};
function find(){const d=D.all(),sp=[...new Set(d.map(x=&gt;x.specialty))],lc=[...new Set(d.map(x=&gt;x.location))];
 const l=d.filter(x=&gt;(!F.sp||x.specialty==F.sp)&amp;&amp;(!F.loc||x.location==F.loc)&amp;&amp;(!F.q||(x.name+x.hospital).toLowerCase().includes(F.q.toLowerCase())));
 view(`&lt;div class=card&gt;&lt;h2&gt;Search doctors / hospitals&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;Specialty&lt;select name=sp&gt;&lt;option value=&quot;&quot;&gt;All&lt;/option&gt;${opts(sp,F.sp)}&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Location&lt;select name=loc&gt;&lt;option value=&quot;&quot;&gt;All&lt;/option&gt;${opts(lc,F.loc)}&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Name / hospital&lt;input name=q value=&quot;${esc(F.q||&#x27;&#x27;)}&quot;&gt;&lt;/label&gt;&lt;button&gt;Search&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;
 &lt;div class=card&gt;${table([[&#x27;Doctor&#x27;,x=&gt;esc(x.name)],[&#x27;Specialty&#x27;,x=&gt;esc(x.specialty)],[&#x27;Hospital&#x27;,x=&gt;esc(x.hospital)],[&#x27;Location&#x27;,x=&gt;esc(x.location)],[&#x27;Fee&#x27;,x=&gt;inr(x.fee)],[&#x27;Rating&#x27;,x=&gt;rating(x.id)],[&#x27;&#x27;,x=&gt;`&lt;button onclick=&quot;S.book(&#x27;${x.id}&#x27;)&quot;&gt;Book&lt;/button&gt;`]],l)}&lt;/div&gt;`);
 onForm(&#x27;#f&#x27;,v=&gt;{F=v;find()})}
function mine(){view(`&lt;div class=card&gt;&lt;h2&gt;My appointments&lt;/h2&gt;${table([[&#x27;Doctor&#x27;,a=&gt;esc(a.docName)],[&#x27;Hospital&#x27;,a=&gt;esc(a.hospital)],[&#x27;Date&#x27;,a=&gt;a.date],[&#x27;Time&#x27;,a=&gt;a.slot],[&#x27;Reason&#x27;,a=&gt;esc(a.reason)],[&#x27;Status&#x27;,a=&gt;a.status+(a.rating?&#x27; · &#x27;+a.rating+&#x27;★&#x27;:&#x27;&#x27;)],[&#x27;&#x27;,a=&gt;a.status==&#x27;Booked&#x27;?`&lt;button onclick=&quot;S.cancel(&#x27;${a.id}&#x27;)&quot;&gt;Cancel&lt;/button&gt;`:a.status==&#x27;Completed&#x27;&amp;&amp;!a.rating?`&lt;button onclick=&quot;S.rate(&#x27;${a.id}&#x27;)&quot;&gt;Rate doctor&lt;/button&gt;`:&#x27;&#x27;]],A.all().filter(a=&gt;a.patientId==U.id).reverse())}&lt;/div&gt;`)}
function profile(){U=Auth.cur();view(`&lt;div class=card style=&quot;max-width:400px&quot;&gt;&lt;h2&gt;My profile&lt;/h2&gt;&lt;form id=f&gt;&lt;label&gt;Name&lt;input name=name value=&quot;${esc(U.name)}&quot; required&gt;&lt;/label&gt;&lt;label&gt;Phone&lt;input name=phone value=&quot;${esc(U.phone||&#x27;&#x27;)}&quot;&gt;&lt;/label&gt;&lt;label&gt;Username&lt;input value=&quot;${esc(U.username)}&quot; disabled&gt;&lt;/label&gt;&lt;button&gt;Update&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;`);onForm(&#x27;#f&#x27;,v=&gt;{Auth.update(U.id,v);toast(&#x27;Profile updated&#x27;)})}
function docs(){view(`&lt;div class=card&gt;&lt;h2&gt;Add doctor&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;Name&lt;input name=name required&gt;&lt;/label&gt;&lt;label&gt;Specialty&lt;input name=specialty required&gt;&lt;/label&gt;&lt;label&gt;Hospital&lt;input name=hospital required&gt;&lt;/label&gt;&lt;label&gt;Location&lt;input name=location required&gt;&lt;/label&gt;&lt;label&gt;Fee&lt;input type=number name=fee required&gt;&lt;/label&gt;&lt;button&gt;Add&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;&lt;div class=card&gt;&lt;h2&gt;Manage doctors&lt;/h2&gt;${table([[&#x27;Doctor&#x27;,x=&gt;esc(x.name)],[&#x27;Specialty&#x27;,x=&gt;esc(x.specialty)],[&#x27;Hospital&#x27;,x=&gt;esc(x.hospital)],[&#x27;Location&#x27;,x=&gt;esc(x.location)],[&#x27;Fee&#x27;,x=&gt;inr(x.fee)],[&#x27;&#x27;,x=&gt;`&lt;button onclick=&quot;S.delDoc(&#x27;${x.id}&#x27;)&quot;&gt;Delete&lt;/button&gt;`]],D.all())}&lt;/div&gt;`);
 onForm(&#x27;#f&#x27;,v=&gt;{D.add({...v,fee:+v.fee});docs()})}
function appts(){view(`&lt;div class=card&gt;&lt;h2&gt;All appointments&lt;/h2&gt;${table([[&#x27;Patient&#x27;,a=&gt;esc(a.patientName)],[&#x27;Doctor&#x27;,a=&gt;esc(a.docName)],[&#x27;Date&#x27;,a=&gt;a.date],[&#x27;Time&#x27;,a=&gt;a.slot],[&#x27;Reason&#x27;,a=&gt;esc(a.reason)],[&#x27;Status&#x27;,a=&gt;a.status],[&#x27;&#x27;,a=&gt;a.status==&#x27;Booked&#x27;?`&lt;button onclick=&quot;S.st(&#x27;${a.id}&#x27;,&#x27;Completed&#x27;)&quot;&gt;Complete&lt;/button&gt; &lt;button onclick=&quot;S.st(&#x27;${a.id}&#x27;,&#x27;Cancelled&#x27;)&quot;&gt;Cancel&lt;/button&gt;`:&#x27;&#x27;]],A.all().reverse())}&lt;/div&gt;`)}
function stats(){const a=A.all(),c=s=&gt;a.filter(x=&gt;x.status==s).length;
 view(`&lt;div class=card&gt;&lt;h2&gt;Appointment statistics&lt;/h2&gt;&lt;span class=stat&gt;&lt;b&gt;${a.length}&lt;/b&gt;Total&lt;/span&gt;&lt;span class=stat&gt;&lt;b&gt;${c(&#x27;Booked&#x27;)}&lt;/b&gt;Booked&lt;/span&gt;&lt;span class=stat&gt;&lt;b&gt;${c(&#x27;Completed&#x27;)}&lt;/b&gt;Completed&lt;/span&gt;&lt;span class=stat&gt;&lt;b&gt;${c(&#x27;Cancelled&#x27;)}&lt;/b&gt;Cancelled&lt;/span&gt;&lt;/div&gt;
 &lt;div class=card&gt;&lt;h2&gt;Doctor ratings&lt;/h2&gt;${table([[&#x27;Doctor&#x27;,x=&gt;esc(x.name)],[&#x27;Appointments&#x27;,x=&gt;a.filter(y=&gt;y.docId==x.id).length],[&#x27;Rating&#x27;,x=&gt;rating(x.id)]],D.all())}&lt;/div&gt;
 &lt;div class=card&gt;&lt;h2&gt;Patient reviews&lt;/h2&gt;${table([[&#x27;Doctor&#x27;,x=&gt;esc(x.docName)],[&#x27;Patient&#x27;,x=&gt;esc(x.patientName)],[&#x27;Rating&#x27;,x=&gt;x.rating+&#x27;★&#x27;],[&#x27;Review&#x27;,x=&gt;esc(x.review)]],a.filter(x=&gt;x.rating))}&lt;/div&gt;`)}
window.S={book(id){const x=D.get(id);view(`&lt;div class=card&gt;&lt;button onclick=&quot;go(0)&quot;&gt;← Back&lt;/button&gt;&lt;h2&gt;Book: ${esc(x.name)}&lt;/h2&gt;&lt;p&gt;${esc(x.specialty)} · ${esc(x.hospital)}, ${esc(x.location)} · ${inr(x.fee)}&lt;/p&gt;
 &lt;iframe src=&quot;https://maps.google.com/maps?q=${encodeURIComponent(x.hospital+&#x27; &#x27;+x.location)}&amp;output=embed&quot;&gt;&lt;/iframe&gt;
 &lt;form id=f class=grid&gt;&lt;label&gt;Date&lt;input type=date name=date min=&quot;${today()}&quot; required&gt;&lt;/label&gt;&lt;label&gt;Time slot&lt;select name=slot id=sl&gt;&lt;option value=&quot;&quot;&gt;Pick a date first&lt;/option&gt;&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Reason / symptoms (check-in form)&lt;input name=reason required&gt;&lt;/label&gt;&lt;button&gt;Confirm booking&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;`);
 const dt=$(&#x27;[name=date]&#x27;);dt.onchange=()=&gt;{const t=A.all().filter(a=&gt;a.docId==id&amp;&amp;a.date==dt.value&amp;&amp;a.status==&#x27;Booked&#x27;).map(a=&gt;a.slot);$(&#x27;#sl&#x27;).innerHTML=SLOTS.filter(s=&gt;!t.includes(s)).map(s=&gt;`&lt;option&gt;${s}&lt;/option&gt;`).join(&#x27;&#x27;)||&#x27;&lt;option value=&quot;&quot;&gt;Fully booked&lt;/option&gt;&#x27;};
 onForm(&#x27;#f&#x27;,v=&gt;{if(!v.slot)return toast(&#x27;No slot available&#x27;);A.add({...v,docId:id,docName:x.name,hospital:x.hospital,patientId:U.id,patientName:U.name,status:&#x27;Booked&#x27;});toast(&#x27;Appointment booked&#x27;);go(1)})},
 cancel(id){if(confirm(&#x27;Cancel this appointment?&#x27;)){A.upd(id,{status:&#x27;Cancelled&#x27;});mine()}},
 rate(id){const r=+prompt(&#x27;Rating (1-5)&#x27;);if(r&gt;=1&amp;&amp;r&lt;=5){A.upd(id,{rating:r,review:prompt(&#x27;Write a short review&#x27;)||&#x27;&#x27;});mine()}},
 delDoc(id){if(confirm(&#x27;Delete doctor?&#x27;)){D.del(id);docs()}},st(id,s){A.upd(id,{status:s});appts()}};
boot({app:&#x27;medcare&#x27;,title:&#x27;MedCare Hospital – Online Appointments&#x27;,roles:[{id:&#x27;patient&#x27;,label:&#x27;Patient&#x27;,reg:true},{id:&#x27;admin&#x27;,label:&#x27;Admin&#x27;}],seed:[{username:&#x27;admin&#x27;,password:&#x27;admin123&#x27;,role:&#x27;admin&#x27;,name:&#x27;Admin&#x27;}],hint:&#x27;Admin login: admin / admin123&#x27;,
 menu:{patient:u=&gt;{U=u;return[[&#x27;Find doctor&#x27;,find],[&#x27;My appointments&#x27;,mine],[&#x27;Profile&#x27;,profile]]},admin:()=&gt;[[&#x27;Appointments&#x27;,appts],[&#x27;Doctors&#x27;,docs],[&#x27;Statistics &amp; ratings&#x27;,stats]]}});
&lt;/script&gt;&lt;/body&gt;&lt;/html&gt;
</code></pre>
        </div>

        <div class="sub-sec">
            <h4>5. SOURCE CODE: CSS3 (style.css)</h4>
            <pre><code>*{box-sizing:border-box}body{margin:0;font:15px/1.5 system-ui,sans-serif;background:#f4f6fb;color:#1f2937}
header{background:#1e3a8a;color:#fff;padding:10px 18px;display:flex;flex-wrap:wrap;gap:12px;align-items:center}
header h1{font-size:18px;margin:0}#nav{display:flex;gap:6px;flex:1;flex-wrap:wrap}#who{font-size:13px}
button{background:#2563eb;color:#fff;border:0;border-radius:6px;padding:6px 12px;cursor:pointer;font:inherit}
button:hover{background:#1d4ed8}button:disabled{background:#9ca3af;cursor:not-allowed}
header button{background:#ffffff26}header button.on{background:#fff;color:#1e3a8a}
main{max-width:1100px;margin:18px auto;padding:0 14px}
.card{background:#fff;border-radius:10px;padding:16px;margin-bottom:14px;box-shadow:0 1px 4px #0001}
h2{margin-top:0;font-size:18px}label{display:block;margin:8px 0;font-size:13px;font-weight:600}
input,select,textarea{width:100%;padding:7px;border:1px solid #cbd5e1;border-radius:6px;font:inherit;margin-top:3px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;align-items:end}
.tw{overflow-x:auto}table{border-collapse:collapse;width:100%}th,td{padding:7px 9px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:14px}th{background:#eef2ff}
.pg{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin-bottom:14px}
.pc{background:#fff;border-radius:10px;padding:12px;box-shadow:0 1px 4px #0001;display:flex;flex-direction:column;gap:4px}
.ic{font-size:44px;text-align:center}.pr{font-weight:700;color:#1e3a8a}
.chip{background:#e0e7ff;color:#1e3a8a;margin:2px}.chip.on{background:#1e3a8a;color:#fff}
.muted{color:#6b7280}.err{color:#dc2626}.ok{color:#16a34a}
.toast{position:fixed;bottom:20px;right:20px;background:#111827;color:#fff;padding:10px 16px;border-radius:8px;z-index:9}
.stat{display:inline-block;background:#eef2ff;border-radius:8px;padding:10px 18px;margin:4px;text-align:center}.stat b{display:block;font-size:22px}
iframe{width:100%;height:280px;border:0;border-radius:8px}
</code></pre>
        </div>

        <div class="sub-sec">
            <h4>6. SOURCE CODE: JAVASCRIPT (script.js)</h4>
            <pre><code>/* Shared helpers: DOM, localStorage &quot;database&quot;, authentication, role-based menus */
const $=(s,e=document)=&gt;e.querySelector(s),$$=(s,e=document)=&gt;[...e.querySelectorAll(s)];
const DB={get(k,d){try{const v=JSON.parse(localStorage.getItem(k));return v??d}catch{return d}},set(k,v){localStorage.setItem(k,JSON.stringify(v))}};
const uid=()=&gt;Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const esc=s=&gt;String(s??&#x27;&#x27;).replace(/[&amp;&lt;&gt;&quot;&#x27;]/g,c=&gt;({&#x27;&amp;&#x27;:&#x27;&amp;amp;&#x27;,&#x27;&lt;&#x27;:&#x27;&amp;lt;&#x27;,&#x27;&gt;&#x27;:&#x27;&amp;gt;&#x27;,&#x27;&quot;&#x27;:&#x27;&amp;quot;&#x27;,&quot;&#x27;&quot;:&#x27;&amp;#39;&#x27;}[c]));
const inr=n=&gt;&#x27;₹&#x27;+Number(n).toLocaleString(&#x27;en-IN&#x27;);
const today=()=&gt;new Date().toISOString().slice(0,10);
const addM=(d,m)=&gt;{const x=new Date(d);x.setMonth(x.getMonth()+m);return x.toISOString().slice(0,10)};
const view=h=&gt;{$(&#x27;#app&#x27;).innerHTML=h};
const go=i=&gt;$$(&#x27;#nav button&#x27;)[i].click();
const toast=m=&gt;{const t=document.createElement(&#x27;div&#x27;);t.className=&#x27;toast&#x27;;t.textContent=m;document.body.append(t);setTimeout(()=&gt;t.remove(),2300)};
const opts=(a,sel)=&gt;a.map(x=&gt;`&lt;option${x==sel?&#x27; selected&#x27;:&#x27;&#x27;}&gt;${esc(x)}&lt;/option&gt;`).join(&#x27;&#x27;);
function table(cols,rows){if(!rows.length)return&#x27;&lt;p class=muted&gt;No records.&lt;/p&gt;&#x27;;return`&lt;div class=tw&gt;&lt;table&gt;&lt;tr&gt;${cols.map(c=&gt;`&lt;th&gt;${c[0]}&lt;/th&gt;`).join(&#x27;&#x27;)}&lt;/tr&gt;${rows.map(r=&gt;`&lt;tr&gt;${cols.map(c=&gt;`&lt;td&gt;${c[1](r)}&lt;/td&gt;`).join(&#x27;&#x27;)}&lt;/tr&gt;`).join(&#x27;&#x27;)}&lt;/table&gt;&lt;/div&gt;`}
function onForm(sel,fn){const f=$(sel);f.onsubmit=e=&gt;{e.preventDefault();fn(Object.fromEntries(new FormData(f)),f)}}
/* Simple collection (table) stored in localStorage */
const Store=(k,seed=[])=&gt;({all(){let v=DB.get(k);if(v==null){v=seed.map(o=&gt;({id:uid(),...o}));DB.set(k,v)}return v},save(v){DB.set(k,v)},
 add(o){const v=this.all();o.id=o.id||uid();v.push(o);this.save(v);return o},upd(id,p){this.save(this.all().map(x=&gt;x.id==id?{...x,...p}:x))},
 del(id){this.save(this.all().filter(x=&gt;x.id!=id))},get(id){return this.all().find(x=&gt;x.id==id)}});
/* Authentication (demo only: passwords are stored in plain text in localStorage) */
const Auth={app:&#x27;&#x27;,init(a,seeds=[]){this.app=a;seeds.forEach(s=&gt;{if(!this.find(s.username,s.role))this.add({...s})})},
 list(){return DB.get(this.app+&#x27;:users&#x27;,[])},find(u,r){return this.list().find(x=&gt;x.username===u&amp;&amp;x.role===r)},
 add(u){const l=this.list();u.id=u.id||uid();l.push(u);DB.set(this.app+&#x27;:users&#x27;,l);return u},
 update(id,p){DB.set(this.app+&#x27;:users&#x27;,this.list().map(x=&gt;x.id===id?{...x,...p}:x))},
 remove(id){DB.set(this.app+&#x27;:users&#x27;,this.list().filter(x=&gt;x.id!==id))},
 cur(){const c=DB.get(this.app+&#x27;:cur&#x27;);return c?this.list().find(x=&gt;x.id===c)||null:null},
 login(u,p,r){const x=this.find(u,r);if(!x||x.password!==p)return&#x27;Invalid username or password&#x27;;if(x.approved===false)return&#x27;Account is waiting for admin approval&#x27;;DB.set(this.app+&#x27;:cur&#x27;,x.id)},
 logout(){localStorage.removeItem(this.app+&#x27;:cur&#x27;)}};
function loginUI(cfg){
 view(`&lt;div class=card style=&quot;max-width:380px;margin:30px auto&quot;&gt;&lt;h2 id=lt&gt;Login&lt;/h2&gt;&lt;form id=f&gt;&lt;label&gt;Role&lt;select name=role&gt;${cfg.roles.map(r=&gt;`&lt;option value=${r.id}&gt;${r.label}&lt;/option&gt;`).join(&#x27;&#x27;)}&lt;/select&gt;&lt;/label&gt;&lt;div id=extra&gt;&lt;/div&gt;&lt;label&gt;Username&lt;input name=username required&gt;&lt;/label&gt;&lt;label&gt;Password&lt;input name=password type=password required&gt;&lt;/label&gt;&lt;button&gt;Login&lt;/button&gt;&lt;/form&gt;&lt;p id=sw class=muted&gt;&lt;/p&gt;&lt;p id=msg class=err&gt;&lt;/p&gt;&lt;/div&gt;`);
 let mode=&#x27;login&#x27;;const f=$(&#x27;#f&#x27;),el=f.elements;
 const sync=()=&gt;{const r=cfg.roles.find(x=&gt;x.id===el.role.value);if(!r.reg)mode=&#x27;login&#x27;;
  $(&#x27;#extra&#x27;).innerHTML=mode==&#x27;reg&#x27;?&#x27;&lt;label&gt;Full name&lt;input name=name required&gt;&lt;/label&gt;&lt;label&gt;Phone&lt;input name=phone&gt;&lt;/label&gt;&#x27;:&#x27;&#x27;;
  f.querySelector(&#x27;button&#x27;).textContent=$(&#x27;#lt&#x27;).textContent=mode==&#x27;reg&#x27;?&#x27;Register&#x27;:&#x27;Login&#x27;;
  $(&#x27;#sw&#x27;).innerHTML=(r.reg?`&lt;a href=# id=tg&gt;${mode==&#x27;reg&#x27;?&#x27;Have an account? Login&#x27;:&#x27;New user? Register&#x27;}&lt;/a&gt;&lt;br&gt;`:&#x27;&#x27;)+(cfg.hint||&#x27;&#x27;);
  const tg=$(&#x27;#tg&#x27;);if(tg)tg.onclick=e=&gt;{e.preventDefault();mode=mode==&#x27;reg&#x27;?&#x27;login&#x27;:&#x27;reg&#x27;;sync()}};
 el.role.onchange=sync;sync();
 f.onsubmit=e=&gt;{e.preventDefault();const d=Object.fromEntries(new FormData(f)),r=cfg.roles.find(x=&gt;x.id==d.role);
  if(mode==&#x27;reg&#x27;){if(Auth.find(d.username,d.role))return $(&#x27;#msg&#x27;).textContent=&#x27;Username already taken&#x27;;
   Auth.add({...d,...(r.approval?{approved:false}:{})});if(r.approval){mode=&#x27;login&#x27;;sync();return $(&#x27;#msg&#x27;).textContent=&#x27;Registered. Please wait for admin approval, then login.&#x27;}}
  const m=Auth.login(d.username,d.password,d.role);if(m)return $(&#x27;#msg&#x27;).textContent=m;boot(cfg)}}
function boot(cfg){
 Auth.init(cfg.app,cfg.seed);document.title=cfg.title;
 document.body.innerHTML=`&lt;header&gt;&lt;h1&gt;${cfg.title}&lt;/h1&gt;&lt;nav id=nav&gt;&lt;/nav&gt;&lt;span id=who&gt;&lt;/span&gt;&lt;/header&gt;&lt;main id=app&gt;&lt;/main&gt;`;
 const u=Auth.cur();if(!u)return loginUI(cfg);
 $(&#x27;#who&#x27;).innerHTML=`${esc(u.name||u.username)} · ${u.role} &lt;button id=lo&gt;Logout&lt;/button&gt;`;$(&#x27;#lo&#x27;).onclick=()=&gt;{Auth.logout();boot(cfg)};
 const items=cfg.menu[u.role](u);$(&#x27;#nav&#x27;).innerHTML=items.map(m=&gt;`&lt;button&gt;${m[0]}&lt;/button&gt;`).join(&#x27;&#x27;);
 const bs=$$(&#x27;#nav button&#x27;);bs.forEach((b,i)=&gt;b.onclick=()=&gt;{bs.forEach(x=&gt;x.classList.remove(&#x27;on&#x27;));b.classList.add(&#x27;on&#x27;);items[i][1]()});bs[0].click()}
</code></pre>
        </div>

