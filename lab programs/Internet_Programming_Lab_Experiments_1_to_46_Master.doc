            <pre><code>* { box-sizing: border-box; margin: 0; padding: 0; font-family: &#x27;Georgia&#x27;, serif; }
body { background: #fafaf9; color: #1c1917; }
.header { background: #1c1917; color: white; padding: 18px 8%; display: flex; justify-content: space-between; align-items: center; }
.artist-brand { font-size: 1.4rem; font-weight: bold; letter-spacing: 1px; }
.artist-brand span { font-size: 0.8rem; color: #a8a29e; font-style: italic; }
nav a { color: #d6d3d1; text-decoration: none; margin-left: 18px; font-size: 0.9rem; }
.container { max-width: 900px; margin: 30px auto; padding: 0 16px; }
.hero { text-align: center; padding: 40px 20px; border-bottom: 1px solid #e7e5e4; }
.hero h2 { font-size: 2.2rem; font-style: italic; margin-bottom: 12px; }
.gallery-sec { margin-top: 30px; }
.art-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-top: 18px; }
.art-card { background: white; padding: 16px; border: 1px solid #e7e5e4; text-align: center; border-radius: 4px; }
.art-placeholder { height: 160px; display: flex; align-items: center; justify-content: center; font-size: 3rem; border-radius: 4px; margin-bottom: 10px; }
.card { background: white; padding: 24px; border: 1px solid #e7e5e4; border-radius: 4px; }
input, textarea { width: 100%; padding: 10px; border: 1px solid #d6d3d1; border-radius: 4px; font-family: sans-serif; }
.btn { background: #1c1917; color: white; padding: 10px 20px; border: none; cursor: pointer; border-radius: 4px; font-weight: bold; }
.toast { position: fixed; bottom: 20px; right: 20px; background: #1c1917; color: white; padding: 10px 18px; border-radius: 4px; display: none; }</code></pre>
        </div>

