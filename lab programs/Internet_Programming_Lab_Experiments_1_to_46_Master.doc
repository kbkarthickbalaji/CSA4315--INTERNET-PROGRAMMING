    <section id="exp_15" class="exp-section">
        <div class="exp-header">
            <h2>EXPERIMENT 15: EASYTOLL ONLINE TOLL PAYMENT SYSTEM</h2>
        </div>

        <div class="sub-sec">
            <h4>1. PROBLEM STATEMENT (QUESTION)</h4>
            <div class="question-box">15. EasyToll, an advanced online toll payment system, simplifies the process of managing 

toll fees for drivers. The website allows users to register and log in to access their toll 

account, where they can view and pay outstanding toll charges from various toll gates. 


Key functionalities include real-time toll balance updates, automatic payment options, 

and the ability to add or update vehicle details. Users can view detailed transaction 

history, set up recurring payments for frequent routes, and receive notifications for 

upcoming toll charges. The platform also supports secure payment methods and 

provides a user-friendly interface for managing toll accounts and reviewing payment 

summaries. EasyToll aims to enhance the convenience of toll payments and reduce wait 

times at toll booths, This website should help the user to pay toll in advance therefore 

not to wait in queue while travelling.

Admin:

• Login

• Manage User &amp; Toll pass

• Manage Toll login

• Approve toll pass

• Generate QR Code

• Create Toll details

User:

• Register

• Login

• Add Money – eWallet

• Buy Toll eTicket

• Apply New toll pass

• Renewal toll pass

• Apply Toll pass

• Get QR Code for Toll pass

Toll Gate User :

• Login

• Scan QR

• Verify toll pass ID

• Verify Toll ticket

• Update toll location</div>
        </div>

        <div class="sub-sec">
            <h4>2. AIM &amp; OBJECTIVES</h4>
            <p>To design, develop and test a responsive web-based easytoll online toll payment system utilizing HTML5, CSS3, and JavaScript.</p>
        </div>

        <div class="sub-sec">
            <h4>3. WEB TECHNOLOGIES UTILIZED</h4>
            <p><strong>Frontend:</strong> HTML5 (Semantic Structure, Form Controls), CSS3 (Flexbox/Grid Layouts, Responsive Design), JavaScript (ES6 DOM Manipulation, Event Listeners, LocalStorage DB simulation).</p>
        </div>

        <div class="sub-sec">
            <h4>4. SOURCE CODE: HTML5 (index.html)</h4>
            <pre><code>&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset=utf-8&gt;&lt;meta name=viewport content=&quot;width=device-width,initial-scale=1&quot;&gt;&lt;link rel=stylesheet href=../style.css&gt;&lt;/head&gt;&lt;body&gt;&lt;script src=../common.js&gt;&lt;/script&gt;&lt;script&gt;
const GT=Store(&#x27;et:gates&#x27;,[{name:&#x27;Sriperumbudur Toll Plaza&#x27;,location:&#x27;NH48, Chennai&#x27;,fee:85},{name:&#x27;Walajapet Toll Plaza&#x27;,location:&#x27;NH48, Vellore&#x27;,fee:120}]),
PS=Store(&#x27;et:passes&#x27;,[]),TK=Store(&#x27;et:tickets&#x27;,[]);const PRICE={Monthly:1000,Yearly:10000};let U;
const me=()=&gt;Auth.cur(),bal=()=&gt;me().wallet||0,pay=n=&gt;{if(bal()&lt;n){toast(&#x27;Insufficient wallet balance&#x27;);return false}Auth.update(U.id,{wallet:bal()-n});return true};
const qr=c=&gt;`&lt;img src=&quot;https://api.qrserver.com/v1/create-qr-code/?size=150x150&amp;data=${encodeURIComponent(c)}&quot; alt=&quot;QR code&quot;&gt;&lt;br&gt;&lt;code&gt;${esc(c)}&lt;/code&gt;`;
const gsel=()=&gt;`&lt;select name=gateId&gt;${GT.all().map(g=&gt;`&lt;option value=${g.id}&gt;${esc(g.name)} – ${inr(g.fee)}&lt;/option&gt;`).join(&#x27;&#x27;)}&lt;/select&gt;`;
function wallet(){view(`&lt;div class=card style=&quot;max-width:400px&quot;&gt;&lt;h2&gt;eWallet&lt;/h2&gt;&lt;h3&gt;Balance: ${inr(bal())}&lt;/h3&gt;&lt;form id=f&gt;&lt;label&gt;Add money (₹)&lt;input type=number name=amt min=1 required&gt;&lt;/label&gt;&lt;button&gt;Add money&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;`);onForm(&#x27;#f&#x27;,v=&gt;{Auth.update(U.id,{wallet:bal()+ +v.amt});wallet()})}
function ticket(){view(`&lt;div class=card&gt;&lt;h2&gt;Buy toll eTicket&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;Toll gate${gsel()}&lt;/label&gt;&lt;label&gt;Vehicle number&lt;input name=vehicle required&gt;&lt;/label&gt;&lt;button&gt;Pay &amp; buy&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;&lt;div class=card&gt;&lt;h2&gt;My tickets&lt;/h2&gt;${table([[&#x27;Date&#x27;,t=&gt;t.date],[&#x27;Gate&#x27;,t=&gt;esc(t.gateName)],[&#x27;Vehicle&#x27;,t=&gt;esc(t.vehicle)],[&#x27;Fee&#x27;,t=&gt;inr(t.fee)],[&#x27;Status&#x27;,t=&gt;t.used?&#x27;Used&#x27;:&#x27;Valid&#x27;]],TK.all().filter(t=&gt;t.userId==U.id).reverse())}&lt;/div&gt;`);
 onForm(&#x27;#f&#x27;,v=&gt;{const g=GT.get(v.gateId);if(!pay(g.fee))return;TK.add({userId:U.id,gateId:g.id,gateName:g.name,vehicle:v.vehicle.toUpperCase(),fee:g.fee,code:&#x27;TK&#x27;+uid().toUpperCase(),date:today(),used:false});toast(&#x27;Ticket purchased&#x27;);ticket()})}
function passes(){view(`&lt;div class=card&gt;&lt;h2&gt;Apply for new toll pass&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;Vehicle number&lt;input name=vehicle required&gt;&lt;/label&gt;&lt;label&gt;Pass type&lt;select name=type&gt;&lt;option&gt;Monthly&lt;/option&gt;&lt;option&gt;Yearly&lt;/option&gt;&lt;/select&gt;&lt;/label&gt;&lt;button&gt;Apply &amp; pay&lt;/button&gt;&lt;/form&gt;&lt;p class=muted&gt;Monthly ${inr(PRICE.Monthly)} · Yearly ${inr(PRICE.Yearly)} (refunded if rejected)&lt;/p&gt;&lt;/div&gt;&lt;div class=card&gt;&lt;h2&gt;My passes&lt;/h2&gt;${table([[&#x27;Vehicle&#x27;,p=&gt;esc(p.vehicle)],[&#x27;Type&#x27;,p=&gt;p.type],[&#x27;Status&#x27;,p=&gt;p.status],[&#x27;Expiry&#x27;,p=&gt;p.expiry||&#x27;-&#x27;],[&#x27;&#x27;,p=&gt;p.status==&#x27;Approved&#x27;?`&lt;button onclick=&quot;S.renew(&#x27;${p.id}&#x27;)&quot;&gt;Renew&lt;/button&gt;`:&#x27;&#x27;]],PS.all().filter(p=&gt;p.userId==U.id))}&lt;/div&gt;`);
 onForm(&#x27;#f&#x27;,v=&gt;{const pr=PRICE[v.type];if(!pay(pr))return;PS.add({userId:U.id,userName:U.name,vehicle:v.vehicle.toUpperCase(),type:v.type,price:pr,status:&#x27;Pending&#x27;});toast(&#x27;Application submitted&#x27;);passes()})}
function myqr(){const ps=PS.all().filter(p=&gt;p.userId==U.id&amp;&amp;p.status==&#x27;Approved&#x27;),ts=TK.all().filter(t=&gt;t.userId==U.id&amp;&amp;!t.used);
 view(`&lt;div class=card&gt;&lt;h2&gt;QR codes – toll passes&lt;/h2&gt;${ps.map(p=&gt;`&lt;div style=&quot;display:inline-block;margin:8px;text-align:center&quot;&gt;${qr(p.code)}&lt;br&gt;${esc(p.vehicle)} · valid till ${p.expiry}&lt;/div&gt;`).join(&#x27;&#x27;)||&#x27;&lt;p&gt;No approved passes.&lt;/p&gt;&#x27;}&lt;/div&gt;&lt;div class=card&gt;&lt;h2&gt;QR codes – unused eTickets&lt;/h2&gt;${ts.map(t=&gt;`&lt;div style=&quot;display:inline-block;margin:8px;text-align:center&quot;&gt;${qr(t.code)}&lt;br&gt;${esc(t.gateName)}&lt;/div&gt;`).join(&#x27;&#x27;)||&#x27;&lt;p&gt;No unused tickets.&lt;/p&gt;&#x27;}&lt;/div&gt;`)}
function aUsers(){view(`&lt;div class=card&gt;&lt;h2&gt;Users&lt;/h2&gt;${table([[&#x27;Name&#x27;,u=&gt;esc(u.name)],[&#x27;Username&#x27;,u=&gt;esc(u.username)],[&#x27;Wallet&#x27;,u=&gt;inr(u.wallet||0)],[&#x27;&#x27;,u=&gt;`&lt;button onclick=&quot;S.delU(&#x27;${u.id}&#x27;)&quot;&gt;Delete&lt;/button&gt;`]],Auth.list().filter(u=&gt;u.role==&#x27;user&#x27;))}&lt;/div&gt;`)}
function aGates(){view(`&lt;div class=card&gt;&lt;h2&gt;Create toll details&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;Toll plaza name&lt;input name=name required&gt;&lt;/label&gt;&lt;label&gt;Location&lt;input name=location required&gt;&lt;/label&gt;&lt;label&gt;Fee per trip (₹)&lt;input type=number name=fee required&gt;&lt;/label&gt;&lt;button&gt;Add&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;&lt;div class=card&gt;${table([[&#x27;Plaza&#x27;,g=&gt;esc(g.name)],[&#x27;Location&#x27;,g=&gt;esc(g.location)],[&#x27;Fee&#x27;,g=&gt;inr(g.fee)],[&#x27;&#x27;,g=&gt;`&lt;button onclick=&quot;S.delG(&#x27;${g.id}&#x27;)&quot;&gt;Delete&lt;/button&gt;`]],GT.all())}&lt;/div&gt;`);onForm(&#x27;#f&#x27;,v=&gt;{GT.add({...v,fee:+v.fee});aGates()})}
function aLogin(){view(`&lt;div class=card&gt;&lt;h2&gt;Create toll gate login&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;Toll gate${gsel()}&lt;/label&gt;&lt;label&gt;Username&lt;input name=username required&gt;&lt;/label&gt;&lt;label&gt;Password&lt;input name=password required&gt;&lt;/label&gt;&lt;button&gt;Create&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;&lt;div class=card&gt;${table([[&#x27;Username&#x27;,u=&gt;esc(u.username)],[&#x27;Gate&#x27;,u=&gt;esc(GT.get(u.gateId)?.name||&#x27;-&#x27;)],[&#x27;&#x27;,u=&gt;`&lt;button onclick=&quot;S.delU(&#x27;${u.id}&#x27;);S.reload()&quot;&gt;Delete&lt;/button&gt;`]],Auth.list().filter(u=&gt;u.role==&#x27;gate&#x27;))}&lt;/div&gt;`);
 onForm(&#x27;#f&#x27;,v=&gt;{if(Auth.find(v.username,&#x27;gate&#x27;))return toast(&#x27;Username taken&#x27;);Auth.add({...v,role:&#x27;gate&#x27;,name:GT.get(v.gateId).name+&#x27; staff&#x27;});aLogin()})}
function aPass(){view(`&lt;div class=card&gt;&lt;h2&gt;Toll pass requests&lt;/h2&gt;${table([[&#x27;User&#x27;,p=&gt;esc(p.userName)],[&#x27;Vehicle&#x27;,p=&gt;esc(p.vehicle)],[&#x27;Type&#x27;,p=&gt;p.type],[&#x27;Status&#x27;,p=&gt;p.status+(p.code?&#x27; · &#x27;+p.code:&#x27;&#x27;)],[&#x27;&#x27;,p=&gt;p.status==&#x27;Pending&#x27;?`&lt;button onclick=&quot;S.ok(&#x27;${p.id}&#x27;)&quot;&gt;Approve &amp; generate QR&lt;/button&gt; &lt;button onclick=&quot;S.no(&#x27;${p.id}&#x27;)&quot;&gt;Reject&lt;/button&gt;`:p.code?`&lt;details&gt;&lt;summary&gt;QR&lt;/summary&gt;${qr(p.code)}&lt;/details&gt;`:&#x27;&#x27;]],PS.all().reverse())}&lt;/div&gt;`)}
function scan(){const g=GT.get(U.gateId);view(`&lt;div class=card&gt;&lt;h2&gt;Scan QR / verify – ${esc(g.name)}&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;QR code / pass ID / ticket no.&lt;input name=code required placeholder=&quot;TP… or TK…&quot;&gt;&lt;/label&gt;&lt;button&gt;Verify&lt;/button&gt;&lt;/form&gt;&lt;div id=res&gt;&lt;/div&gt;&lt;/div&gt;`);
 onForm(&#x27;#f&#x27;,v=&gt;{const c=v.code.trim().toUpperCase(),p=PS.all().find(x=&gt;x.code==c),t=TK.all().find(x=&gt;x.code==c);let m;
  if(p){const ok=p.status==&#x27;Approved&#x27;&amp;&amp;p.expiry&gt;=today();m=[ok,`Toll pass ${p.code} – ${p.vehicle} (${p.userName}) – ${ok?&#x27;VALID until &#x27;+p.expiry:&#x27;EXPIRED / not approved&#x27;}`]}
  else if(t){const ok=!t.used&amp;&amp;t.gateId==g.id;m=[ok,`Toll ticket ${t.code} – ${t.vehicle} – ${t.used?&#x27;ALREADY USED&#x27;:t.gateId!=g.id?&#x27;issued for &#x27;+t.gateName:&#x27;VALID – gate opened&#x27;}`];if(ok)TK.upd(t.id,{used:true})}
  else m=[false,&#x27;Code not found&#x27;];$(&#x27;#res&#x27;).innerHTML=`&lt;h3 class=${m[0]?&#x27;ok&#x27;:&#x27;err&#x27;}&gt;${m[0]?&#x27;✔&#x27;:&#x27;✖&#x27;} ${esc(m[1])}&lt;/h3&gt;`})}
function loc(){const g=GT.get(U.gateId);view(`&lt;div class=card style=&quot;max-width:420px&quot;&gt;&lt;h2&gt;Update toll location&lt;/h2&gt;&lt;form id=f&gt;&lt;label&gt;Plaza&lt;input value=&quot;${esc(g.name)}&quot; disabled&gt;&lt;/label&gt;&lt;label&gt;Location&lt;input name=location value=&quot;${esc(g.location)}&quot; required&gt;&lt;/label&gt;&lt;button&gt;Update&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;`);onForm(&#x27;#f&#x27;,v=&gt;{GT.upd(g.id,v);toast(&#x27;Location updated&#x27;)})}
window.S={renew(id){const p=PS.get(id);if(!pay(p.price))return;const b=p.expiry&gt;today()?p.expiry:today();PS.upd(id,{expiry:addM(b,p.type==&#x27;Monthly&#x27;?1:12)});toast(&#x27;Pass renewed&#x27;);passes()},
 delU(id){Auth.remove(id);aUsers()},reload(){aLogin()},delG(id){GT.del(id);aGates()},
 ok(id){const p=PS.get(id);PS.upd(id,{status:&#x27;Approved&#x27;,code:&#x27;TP&#x27;+uid().toUpperCase(),expiry:addM(today(),p.type==&#x27;Monthly&#x27;?1:12)});aPass()},
 no(id){const p=PS.get(id),u=Auth.list().find(x=&gt;x.id==p.userId);if(u)Auth.update(u.id,{wallet:(u.wallet||0)+p.price});PS.upd(id,{status:&#x27;Rejected&#x27;});aPass()}};
boot({app:&#x27;easytoll&#x27;,title:&#x27;EasyToll – Online Toll Payment&#x27;,roles:[{id:&#x27;user&#x27;,label:&#x27;Driver&#x27;,reg:true},{id:&#x27;gate&#x27;,label:&#x27;Toll gate staff&#x27;},{id:&#x27;admin&#x27;,label:&#x27;Admin&#x27;}],seed:[{username:&#x27;admin&#x27;,password:&#x27;admin123&#x27;,role:&#x27;admin&#x27;,name:&#x27;Admin&#x27;}],
 hint:&#x27;Admin: admin / admin123. Admin creates toll gate staff logins.&#x27;,
 menu:{user:u=&gt;{U=u;return[[&#x27;eWallet&#x27;,wallet],[&#x27;Buy eTicket&#x27;,ticket],[&#x27;Toll pass&#x27;,passes],[&#x27;My QR codes&#x27;,myqr]]},admin:()=&gt;[[&#x27;Passes&#x27;,aPass],[&#x27;Toll gates&#x27;,aGates],[&#x27;Gate logins&#x27;,aLogin],[&#x27;Users&#x27;,aUsers]],gate:u=&gt;{U=u;return[[&#x27;Scan &amp; verify&#x27;,scan],[&#x27;Update location&#x27;,loc]]}}});
&lt;/script&gt;&lt;/body&gt;&lt;/html&gt;
</code></pre>
        </div>

        <div class="sub-sec">
            <h4>5. SOURCE CODE: CSS3 (style.css)</h4>
            <pre><code>*{box-sizing:border-box}body{margin:0;font:15px/1.5 system-ui,sans-serif;background:#f4f6fb;color:#1f2937}
header{background:#1e3a8a;color:#fff;padding:10px 18px;display:flex;flex-wrap:wrap;gap:12px;align-items:center}
header h1{font-size:18px;margin:0}#nav{display:flex;gap:6px;flex:1;flex-wrap:wrap}#who{font-size:13px}
button{background:#2563eb;color:#fff;border:0;border-radius:6px;padding:6px 12px;cursor:pointer;font:inherit}
button:hover{background:#1d4ed8}button:disabled{background:#9ca3af;cursor:not-allowed}
header button{background:#ffffff26}header button.on{background:#fff;color:#1e3a8a}
main{max-width:1100px;margin:18px auto;padding:0 14px}
.card{background:#fff;border-radius:10px;padding:16px;margin-bottom:14px;box-shadow:0 1px 4px #0001}
h2{margin-top:0;font-size:18px}label{display:block;margin:8px 0;font-size:13px;font-weight:600}
input,select,textarea{width:100%;padding:7px;border:1px solid #cbd5e1;border-radius:6px;font:inherit;margin-top:3px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;align-items:end}
.tw{overflow-x:auto}table{border-collapse:collapse;width:100%}th,td{padding:7px 9px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:14px}th{background:#eef2ff}
.pg{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin-bottom:14px}
.pc{background:#fff;border-radius:10px;padding:12px;box-shadow:0 1px 4px #0001;display:flex;flex-direction:column;gap:4px}
.ic{font-size:44px;text-align:center}.pr{font-weight:700;color:#1e3a8a}
.chip{background:#e0e7ff;color:#1e3a8a;margin:2px}.chip.on{background:#1e3a8a;color:#fff}
.muted{color:#6b7280}.err{color:#dc2626}.ok{color:#16a34a}
.toast{position:fixed;bottom:20px;right:20px;background:#111827;color:#fff;padding:10px 16px;border-radius:8px;z-index:9}
.stat{display:inline-block;background:#eef2ff;border-radius:8px;padding:10px 18px;margin:4px;text-align:center}.stat b{display:block;font-size:22px}
iframe{width:100%;height:280px;border:0;border-radius:8px}
</code></pre>
        </div>

        <div class="sub-sec">
            <h4>6. SOURCE CODE: JAVASCRIPT (script.js)</h4>
            <pre><code>/* Shared helpers: DOM, localStorage &quot;database&quot;, authentication, role-based menus */
const $=(s,e=document)=&gt;e.querySelector(s),$$=(s,e=document)=&gt;[...e.querySelectorAll(s)];
const DB={get(k,d){try{const v=JSON.parse(localStorage.getItem(k));return v??d}catch{return d}},set(k,v){localStorage.setItem(k,JSON.stringify(v))}};
const uid=()=&gt;Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const esc=s=&gt;String(s??&#x27;&#x27;).replace(/[&amp;&lt;&gt;&quot;&#x27;]/g,c=&gt;({&#x27;&amp;&#x27;:&#x27;&amp;amp;&#x27;,&#x27;&lt;&#x27;:&#x27;&amp;lt;&#x27;,&#x27;&gt;&#x27;:&#x27;&amp;gt;&#x27;,&#x27;&quot;&#x27;:&#x27;&amp;quot;&#x27;,&quot;&#x27;&quot;:&#x27;&amp;#39;&#x27;}[c]));
const inr=n=&gt;&#x27;₹&#x27;+Number(n).toLocaleString(&#x27;en-IN&#x27;);
const today=()=&gt;new Date().toISOString().slice(0,10);
const addM=(d,m)=&gt;{const x=new Date(d);x.setMonth(x.getMonth()+m);return x.toISOString().slice(0,10)};
const view=h=&gt;{$(&#x27;#app&#x27;).innerHTML=h};
const go=i=&gt;$$(&#x27;#nav button&#x27;)[i].click();
const toast=m=&gt;{const t=document.createElement(&#x27;div&#x27;);t.className=&#x27;toast&#x27;;t.textContent=m;document.body.append(t);setTimeout(()=&gt;t.remove(),2300)};
const opts=(a,sel)=&gt;a.map(x=&gt;`&lt;option${x==sel?&#x27; selected&#x27;:&#x27;&#x27;}&gt;${esc(x)}&lt;/option&gt;`).join(&#x27;&#x27;);
function table(cols,rows){if(!rows.length)return&#x27;&lt;p class=muted&gt;No records.&lt;/p&gt;&#x27;;return`&lt;div class=tw&gt;&lt;table&gt;&lt;tr&gt;${cols.map(c=&gt;`&lt;th&gt;${c[0]}&lt;/th&gt;`).join(&#x27;&#x27;)}&lt;/tr&gt;${rows.map(r=&gt;`&lt;tr&gt;${cols.map(c=&gt;`&lt;td&gt;${c[1](r)}&lt;/td&gt;`).join(&#x27;&#x27;)}&lt;/tr&gt;`).join(&#x27;&#x27;)}&lt;/table&gt;&lt;/div&gt;`}
function onForm(sel,fn){const f=$(sel);f.onsubmit=e=&gt;{e.preventDefault();fn(Object.fromEntries(new FormData(f)),f)}}
/* Simple collection (table) stored in localStorage */
const Store=(k,seed=[])=&gt;({all(){let v=DB.get(k);if(v==null){v=seed.map(o=&gt;({id:uid(),...o}));DB.set(k,v)}return v},save(v){DB.set(k,v)},
 add(o){const v=this.all();o.id=o.id||uid();v.push(o);this.save(v);return o},upd(id,p){this.save(this.all().map(x=&gt;x.id==id?{...x,...p}:x))},
 del(id){this.save(this.all().filter(x=&gt;x.id!=id))},get(id){return this.all().find(x=&gt;x.id==id)}});
/* Authentication (demo only: passwords are stored in plain text in localStorage) */
const Auth={app:&#x27;&#x27;,init(a,seeds=[]){this.app=a;seeds.forEach(s=&gt;{if(!this.find(s.username,s.role))this.add({...s})})},
 list(){return DB.get(this.app+&#x27;:users&#x27;,[])},find(u,r){return this.list().find(x=&gt;x.username===u&amp;&amp;x.role===r)},
 add(u){const l=this.list();u.id=u.id||uid();l.push(u);DB.set(this.app+&#x27;:users&#x27;,l);return u},
 update(id,p){DB.set(this.app+&#x27;:users&#x27;,this.list().map(x=&gt;x.id===id?{...x,...p}:x))},
 remove(id){DB.set(this.app+&#x27;:users&#x27;,this.list().filter(x=&gt;x.id!==id))},
 cur(){const c=DB.get(this.app+&#x27;:cur&#x27;);return c?this.list().find(x=&gt;x.id===c)||null:null},
 login(u,p,r){const x=this.find(u,r);if(!x||x.password!==p)return&#x27;Invalid username or password&#x27;;if(x.approved===false)return&#x27;Account is waiting for admin approval&#x27;;DB.set(this.app+&#x27;:cur&#x27;,x.id)},
 logout(){localStorage.removeItem(this.app+&#x27;:cur&#x27;)}};
function loginUI(cfg){
 view(`&lt;div class=card style=&quot;max-width:380px;margin:30px auto&quot;&gt;&lt;h2 id=lt&gt;Login&lt;/h2&gt;&lt;form id=f&gt;&lt;label&gt;Role&lt;select name=role&gt;${cfg.roles.map(r=&gt;`&lt;option value=${r.id}&gt;${r.label}&lt;/option&gt;`).join(&#x27;&#x27;)}&lt;/select&gt;&lt;/label&gt;&lt;div id=extra&gt;&lt;/div&gt;&lt;label&gt;Username&lt;input name=username required&gt;&lt;/label&gt;&lt;label&gt;Password&lt;input name=password type=password required&gt;&lt;/label&gt;&lt;button&gt;Login&lt;/button&gt;&lt;/form&gt;&lt;p id=sw class=muted&gt;&lt;/p&gt;&lt;p id=msg class=err&gt;&lt;/p&gt;&lt;/div&gt;`);
 let mode=&#x27;login&#x27;;const f=$(&#x27;#f&#x27;),el=f.elements;
 const sync=()=&gt;{const r=cfg.roles.find(x=&gt;x.id===el.role.value);if(!r.reg)mode=&#x27;login&#x27;;
  $(&#x27;#extra&#x27;).innerHTML=mode==&#x27;reg&#x27;?&#x27;&lt;label&gt;Full name&lt;input name=name required&gt;&lt;/label&gt;&lt;label&gt;Phone&lt;input name=phone&gt;&lt;/label&gt;&#x27;:&#x27;&#x27;;
  f.querySelector(&#x27;button&#x27;).textContent=$(&#x27;#lt&#x27;).textContent=mode==&#x27;reg&#x27;?&#x27;Register&#x27;:&#x27;Login&#x27;;
  $(&#x27;#sw&#x27;).innerHTML=(r.reg?`&lt;a href=# id=tg&gt;${mode==&#x27;reg&#x27;?&#x27;Have an account? Login&#x27;:&#x27;New user? Register&#x27;}&lt;/a&gt;&lt;br&gt;`:&#x27;&#x27;)+(cfg.hint||&#x27;&#x27;);
  const tg=$(&#x27;#tg&#x27;);if(tg)tg.onclick=e=&gt;{e.preventDefault();mode=mode==&#x27;reg&#x27;?&#x27;login&#x27;:&#x27;reg&#x27;;sync()}};
 el.role.onchange=sync;sync();
 f.onsubmit=e=&gt;{e.preventDefault();const d=Object.fromEntries(new FormData(f)),r=cfg.roles.find(x=&gt;x.id==d.role);
  if(mode==&#x27;reg&#x27;){if(Auth.find(d.username,d.role))return $(&#x27;#msg&#x27;).textContent=&#x27;Username already taken&#x27;;
   Auth.add({...d,...(r.approval?{approved:false}:{})});if(r.approval){mode=&#x27;login&#x27;;sync();return $(&#x27;#msg&#x27;).textContent=&#x27;Registered. Please wait for admin approval, then login.&#x27;}}
  const m=Auth.login(d.username,d.password,d.role);if(m)return $(&#x27;#msg&#x27;).textContent=m;boot(cfg)}}
function boot(cfg){
 Auth.init(cfg.app,cfg.seed);document.title=cfg.title;
 document.body.innerHTML=`&lt;header&gt;&lt;h1&gt;${cfg.title}&lt;/h1&gt;&lt;nav id=nav&gt;&lt;/nav&gt;&lt;span id=who&gt;&lt;/span&gt;&lt;/header&gt;&lt;main id=app&gt;&lt;/main&gt;`;
 const u=Auth.cur();if(!u)return loginUI(cfg);
 $(&#x27;#who&#x27;).innerHTML=`${esc(u.name||u.username)} · ${u.role} &lt;button id=lo&gt;Logout&lt;/button&gt;`;$(&#x27;#lo&#x27;).onclick=()=&gt;{Auth.logout();boot(cfg)};
 const items=cfg.menu[u.role](u);$(&#x27;#nav&#x27;).innerHTML=items.map(m=&gt;`&lt;button&gt;${m[0]}&lt;/button&gt;`).join(&#x27;&#x27;);
 const bs=$$(&#x27;#nav button&#x27;);bs.forEach((b,i)=&gt;b.onclick=()=&gt;{bs.forEach(x=&gt;x.classList.remove(&#x27;on&#x27;));b.classList.add(&#x27;on&#x27;);items[i][1]()});bs[0].click()}
</code></pre>
        </div>

