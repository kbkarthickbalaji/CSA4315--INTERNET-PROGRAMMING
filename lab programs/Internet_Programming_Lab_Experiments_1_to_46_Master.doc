        <div class="sub-sec">
            <h4>4. SOURCE CODE: HTML5 (index.html)</h4>
            <pre><code>&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
    &lt;meta charset=&quot;UTF-8&quot;&gt;
    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;
    &lt;title&gt;AgriMart - Farmer Supplies &amp; Equipment&lt;/title&gt;
    &lt;link rel=&quot;stylesheet&quot; href=&quot;style.css&quot;&gt;
&lt;/head&gt;
&lt;body&gt;
    &lt;header class=&quot;header&quot;&gt;
        &lt;div class=&quot;brand&quot;&gt;🌱 Agri&lt;span&gt;Mart&lt;/span&gt;&lt;/div&gt;
        &lt;div class=&quot;cart-pill&quot; onclick=&quot;toggleCart()&quot;&gt;🛒 Cart: &lt;span id=&quot;cartCount&quot;&gt;0&lt;/span&gt; items&lt;/div&gt;
    &lt;/header&gt;
    &lt;main class=&quot;container&quot;&gt;
        &lt;div class=&quot;hero&quot;&gt;
            &lt;h2&gt;Government-Subsidized Agricultural Store&lt;/h2&gt;
            &lt;p&gt;Direct from verified manufacturers to Indian farmers at subsidized fair-trade prices.&lt;/p&gt;
        &lt;/div&gt;
        &lt;div class=&quot;filter-bar&quot;&gt;
            &lt;button class=&quot;filter-btn active&quot; onclick=&quot;filterProducts(&#x27;All&#x27;)&quot;&gt;All Products&lt;/button&gt;
            &lt;button class=&quot;filter-btn&quot; onclick=&quot;filterProducts(&#x27;Seeds&#x27;)&quot;&gt;Hybrid Seeds&lt;/button&gt;
            &lt;button class=&quot;filter-btn&quot; onclick=&quot;filterProducts(&#x27;Fertilizers&#x27;)&quot;&gt;Organic Fertilizers&lt;/button&gt;
            &lt;button class=&quot;filter-btn&quot; onclick=&quot;filterProducts(&#x27;Pesticides&#x27;)&quot;&gt;Crop Protection&lt;/button&gt;
            &lt;button class=&quot;filter-btn&quot; onclick=&quot;filterProducts(&#x27;Tools&#x27;)&quot;&gt;Equipment &amp; Tools&lt;/button&gt;
        &lt;/div&gt;
        &lt;div id=&quot;productGrid&quot; class=&quot;product-grid&quot;&gt;&lt;/div&gt;
    &lt;/main&gt;
    &lt;aside id=&quot;cartDrawer&quot; class=&quot;cart-drawer&quot;&gt;
        &lt;div class=&quot;cart-header&quot;&gt;
            &lt;h3&gt;Farmer Order Basket&lt;/h3&gt;
            &lt;button onclick=&quot;toggleCart()&quot;&gt;✕&lt;/button&gt;
        &lt;/div&gt;
        &lt;div id=&quot;cartItems&quot; class=&quot;cart-body&quot;&gt;&lt;/div&gt;
        &lt;div class=&quot;cart-footer&quot;&gt;
            &lt;div class=&quot;total-row&quot;&gt;Total: &lt;strong id=&quot;cartTotal&quot;&gt;₹0&lt;/strong&gt;&lt;/div&gt;
            &lt;button class=&quot;btn btn-primary&quot; onclick=&quot;checkout()&quot;&gt;Proceed to Subsidized Checkout&lt;/button&gt;
        &lt;/div&gt;
    &lt;/aside&gt;
    &lt;div id=&quot;toast&quot; class=&quot;toast&quot;&gt;&lt;/div&gt;
    &lt;script src=&quot;script.js&quot;&gt;&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;</code></pre>
        </div>

        <div class="sub-sec">
            <h4>5. SOURCE CODE: CSS3 (style.css)</h4>
            <pre><code>* { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, sans-serif; }
body { background: #f7fee7; color: #14532d; }
.header { background: #15803d; color: white; padding: 14px 6%; display: flex; justify-content: space-between; align-items: center; }
.brand { font-size: 1.4rem; font-weight: 700; }
.brand span { color: #fde047; }
.cart-pill { background: #166534; padding: 6px 14px; border-radius: 20px; cursor: pointer; font-weight: 600; }
.container { max-width: 1060px; margin: 24px auto; padding: 0 16px; }
.hero { background: white; padding: 24px; border-radius: 8px; border-left: 5px solid #16a34a; margin-bottom: 20px; }
.filter-bar { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
.filter-btn { background: white; border: 1.5px solid #86efac; color: #166534; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 600; }
.filter-btn.active, .filter-btn:hover { background: #15803d; color: white; border-color: #15803d; }
.product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 18px; }
.prod-card { background: white; border-radius: 8px; padding: 18px; border: 1px solid #dcfce7; display: flex; flex-direction: column; justify-content: space-between; }
.prod-card h4 { font-size: 1.05rem; margin-bottom: 4px; }
.prod-cat { font-size: 0.75rem; color: #16a34a; font-weight: 700; text-transform: uppercase; }
.prod-price { font-size: 1.2rem; font-weight: 800; margin: 10px 0; color: #14532d; }
.badge-subsidy { background: #fef08a; color: #854d0e; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; }
.btn { padding: 9px 16px; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; }
.btn-primary { background: #15803d; color: white; width: 100%; }
.cart-drawer { position: fixed; top: 0; right: -360px; width: 340px; height: 100vh; background: white; box-shadow: -4px 0 16px rgba(0,0,0,0.15); transition: right 0.3s; z-index: 99; display: flex; flex-direction: column; }
.cart-drawer.open { right: 0; }
.cart-header { background: #15803d; color: white; padding: 16px; display: flex; justify-content: space-between; }
.cart-header button { background: none; border: none; color: white; font-size: 1.2rem; cursor: pointer; }
.cart-body { flex: 1; overflow-y: auto; padding: 16px; }
.cart-footer { padding: 16px; border-top: 1px solid #e2e8f0; }
.total-row { display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 1.1rem; }
.toast { position: fixed; bottom: 20px; right: 20px; background: #15803d; color: white; padding: 10px 18px; border-radius: 6px; display: none; }</code></pre>
        </div>

        <div class="sub-sec">
            <h4>6. SOURCE CODE: JAVASCRIPT (script.js)</h4>
            <pre><code>const products = [
    { id: 1, name: &#x27;BPT-5204 Paddy Seeds (25kg)&#x27;, cat: &#x27;Seeds&#x27;, price: 1250, subsidy: &#x27;20% Subsidy&#x27; },
    { id: 2, name: &#x27;Hybrid Cotton Bt-II Seeds&#x27;, cat: &#x27;Seeds&#x27;, price: 950, subsidy: &#x27;15% Subsidy&#x27; },
    { id: 3, name: &#x27;Bio-NPK Organic Fertilizer (50kg)&#x27;, cat: &#x27;Fertilizers&#x27;, price: 680, subsidy: &#x27;Govt Regulated&#x27; },
    { id: 4, name: &#x27;Neem-Based Eco Pesticide (1L)&#x27;, cat: &#x27;Pesticides&#x27;, price: 420, subsidy: &#x27;Organic Scheme&#x27; },
    { id: 5, name: &#x27;Battery Powered Knapsack Sprayer&#x27;, cat: &#x27;Tools&#x27;, price: 2800, subsidy: &#x27;30% Subsidized&#x27; },
    { id: 6, name: &#x27;Drip Irrigation Starter Kit (1 Acre)&#x27;, cat: &#x27;Tools&#x27;, price: 4500, subsidy: &#x27;PMKSY Approved&#x27; }
];
let cart = [];
function showToast(m) { const t = document.getElementById(&#x27;toast&#x27;); t.innerText = m; t.style.display = &#x27;block&#x27;; setTimeout(() =&gt; t.style.display = &#x27;none&#x27;, 2000); }
function toggleCart() { document.getElementById(&#x27;cartDrawer&#x27;).classList.toggle(&#x27;open&#x27;); }
function filterProducts(cat) {
    document.querySelectorAll(&#x27;.filter-btn&#x27;).forEach(b =&gt; b.classList.remove(&#x27;active&#x27;));
    event.target.classList.add(&#x27;active&#x27;);
    renderGrid(cat === &#x27;All&#x27; ? products : products.filter(p =&gt; p.cat === cat));
}
function renderGrid(list) {
    const grid = document.getElementById(&#x27;productGrid&#x27;);
    grid.innerHTML = &#x27;&#x27;;
    list.forEach(p =&gt; {
        grid.innerHTML += `
            &lt;div class=&quot;prod-card&quot;&gt;
                &lt;div&gt;
                    &lt;span class=&quot;prod-cat&quot;&gt;${p.cat}&lt;/span&gt;
                    &lt;h4&gt;${p.name}&lt;/h4&gt;
                    &lt;span class=&quot;badge-subsidy&quot;&gt;${p.subsidy}&lt;/span&gt;
                &lt;/div&gt;
                &lt;div&gt;
                    &lt;div class=&quot;prod-price&quot;&gt;₹${p.price}&lt;/div&gt;
                    &lt;button class=&quot;btn btn-primary&quot; onclick=&quot;addToCart(${p.id})&quot;&gt;Add to Basket&lt;/button&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        `;
    });
}
function addToCart(id) {
    const item = products.find(x =&gt; x.id === id);
    const inCart = cart.find(x =&gt; x.id === id);
    if (inCart) inCart.qty++; else cart.push({ ...item, qty: 1 });
    updateCartUI();
    showToast(`Added ${item.name} to basket`);
}
function updateCartUI() {
    const totalCount = cart.reduce((s, c) =&gt; s + c.qty, 0);
    const totalPrice = cart.reduce((s, c) =&gt; s + (c.price * c.qty), 0);
    document.getElementById(&#x27;cartCount&#x27;).innerText = totalCount;
    document.getElementById(&#x27;cartTotal&#x27;).innerText = &#x27;₹&#x27; + totalPrice;
    const body = document.getElementById(&#x27;cartItems&#x27;);
    body.innerHTML = cart.length ? &#x27;&#x27; : &#x27;&lt;p style=&quot;color:#64748b;&quot;&gt;Basket is empty.&lt;/p&gt;&#x27;;
    cart.forEach(c =&gt; {
        body.innerHTML += `&lt;div style=&quot;display:flex; justify-content:space-between; margin-bottom:10px;&quot;&gt;
            &lt;div&gt;&lt;strong&gt;${c.name}&lt;/strong&gt;&lt;br&gt;&lt;small&gt;Qty: ${c.qty} × ₹${c.price}&lt;/small&gt;&lt;/div&gt;
            &lt;button onclick=&quot;removeFromCart(${c.id})&quot; style=&quot;color:red; background:none; border:none; cursor:pointer;&quot;&gt;✕&lt;/button&gt;
        &lt;/div&gt;`;
    });
}
function removeFromCart(id) { cart = cart.filter(x =&gt; x.id !== id); updateCartUI(); }
function checkout() {
    if (!cart.length) { showToast(&#x27;Basket is empty!&#x27;); return; }
    showToast(&#x27;Order confirmed! Subsidized invoice sent to registered mobile.&#x27;);
    cart = [];
    updateCartUI();
    toggleCart();
}
window.addEventListener(&#x27;DOMContentLoaded&#x27;, () =&gt; renderGrid(products));</code></pre>
        </div>

