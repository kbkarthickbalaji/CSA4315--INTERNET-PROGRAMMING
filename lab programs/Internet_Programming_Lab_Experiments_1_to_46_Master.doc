                &lt;input type=&quot;text&quot; id=&quot;artClient&quot; required placeholder=&quot;Your Name&quot; style=&quot;margin-bottom:10px;&quot;&gt;
                &lt;input type=&quot;email&quot; id=&quot;artEmail&quot; required placeholder=&quot;Your Email&quot; style=&quot;margin-bottom:10px;&quot;&gt;
                &lt;textarea rows=&quot;3&quot; placeholder=&quot;Describe canvas dimensions, preferred medium or custom vision...&quot; required&gt;&lt;/textarea&gt;
                &lt;button type=&quot;submit&quot; class=&quot;btn&quot;&gt;Send Commission Request&lt;/button&gt;
