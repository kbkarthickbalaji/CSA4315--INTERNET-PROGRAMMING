            &lt;div class=&quot;skill-bar&quot;&gt;&lt;span&gt;Asynchronous AJAX &amp;amp; RESTful JSON&lt;/span&gt;&lt;div class=&quot;track&quot;&gt;&lt;div class=&quot;fill&quot; style=&quot;width:88%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;
            &lt;div class=&quot;skill-bar&quot;&gt;&lt;span&gt;Python Flask &amp;amp; Relational SQLite/MySQL&lt;/span&gt;&lt;div class=&quot;track&quot;&gt;&lt;div class=&quot;fill&quot; style=&quot;width:85%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;
            &lt;div class=&quot;skill-bar&quot;&gt;&lt;span&gt;XML Document Design &amp;amp; XSLT Styling&lt;/span&gt;&lt;div class=&quot;track&quot;&gt;&lt;div class=&quot;fill&quot; style=&quot;width:84%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;
