        <div class="sub-sec">
            <h4>2. AIM &amp; OBJECTIVES</h4>
            <p>To construct an integrated e-commerce and repair service ticketing portal for laptops, featuring spare parts booking and job sheet tracking.</p>
        </div>

        <div class="sub-sec">
            <h4>3. WEB TECHNOLOGIES UTILIZED</h4>
            <p><strong>Frontend:</strong> HTML5 (Semantic Structure, Form Controls), CSS3 (Flexbox/Grid Layouts, Responsive Design), JavaScript (ES6 DOM Manipulation, Event Listeners, LocalStorage DB simulation).</p>
        </div>

        <div class="sub-sec">
            <h4>4. SOURCE CODE: HTML5 (index.html)</h4>
            <pre><code>&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
    &lt;meta charset=&quot;UTF-8&quot;&gt;
    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;
    &lt;title&gt;Ram Infotech - Laptop Sales &amp; Service&lt;/title&gt;
    &lt;link rel=&quot;stylesheet&quot; href=&quot;style.css&quot;&gt;
&lt;/head&gt;
&lt;body&gt;
    &lt;header class=&quot;header&quot;&gt;
        &lt;h1&gt;💻 Ram &lt;span&gt;Infotech&lt;/span&gt;&lt;/h1&gt;
        &lt;p&gt;Expert Multi-Brand Laptop Sales, Chip-Level Repairs &amp;amp; Upgrades&lt;/p&gt;
    &lt;/header&gt;
    &lt;main class=&quot;container&quot;&gt;
        &lt;section class=&quot;card&quot;&gt;
            &lt;h3&gt;Book Laptop Service / Track Job Sheet&lt;/h3&gt;
            &lt;form onsubmit=&quot;bookService(event)&quot;&gt;
                &lt;div class=&quot;row&quot;&gt;
                    &lt;div&gt;
                        &lt;label&gt;Laptop Brand &amp;amp; Model *&lt;/label&gt;
                        &lt;input type=&quot;text&quot; id=&quot;lapModel&quot; required placeholder=&quot;e.g. Dell Inspiron 15 / HP Pavilion&quot;&gt;
                    &lt;/div&gt;
                    &lt;div&gt;
                        &lt;label&gt;Hardware / OS Problem *&lt;/label&gt;
                        &lt;select id=&quot;lapIssue&quot;&gt;
                            &lt;option&gt;Display Screen Damage / Lines&lt;/option&gt;
                            &lt;option&gt;Battery Replacement / Not Charging&lt;/option&gt;
                            &lt;option&gt;RAM / NVMe SSD Speed Upgrade&lt;/option&gt;
                            &lt;option&gt;Motherboard Chip-Level No Power&lt;/option&gt;
                        &lt;/select&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
                &lt;div class=&quot;row&quot;&gt;
                    &lt;div&gt;
                        &lt;label&gt;Customer Name *&lt;/label&gt;
                        &lt;input type=&quot;text&quot; id=&quot;custName&quot; required placeholder=&quot;Your Name&quot;&gt;
                    &lt;/div&gt;
                    &lt;div&gt;
                        &lt;label&gt;Phone Number *&lt;/label&gt;
                        &lt;input type=&quot;tel&quot; id=&quot;custPhone&quot; required pattern=&quot;[0-9]{10}&quot; placeholder=&quot;9876543210&quot;&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
                &lt;button type=&quot;submit&quot; class=&quot;btn btn-primary&quot;&gt;Generate Service Job Sheet Token&lt;/button&gt;
            &lt;/form&gt;
        &lt;/section&gt;
        &lt;section class=&quot;card&quot; style=&quot;margin-top:20px;&quot;&gt;
            &lt;h3&gt;Active Service Tickets&lt;/h3&gt;
            &lt;div id=&quot;serviceQueue&quot;&gt;&lt;/div&gt;
        &lt;/section&gt;
    &lt;/main&gt;
    &lt;div id=&quot;toast&quot; class=&quot;toast&quot;&gt;&lt;/div&gt;
    &lt;script src=&quot;script.js&quot;&gt;&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;</code></pre>
        </div>

        <div class="sub-sec">
            <h4>5. SOURCE CODE: CSS3 (style.css)</h4>
            <pre><code>* { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, sans-serif; }
body { background: #f8fafc; color: #0f172a; }
.header { background: #0f172a; color: white; padding: 18px 6%; text-align: center; }
.header span { color: #38bdf8; }
.container { max-width: 860px; margin: 24px auto; padding: 0 16px; }
.card { background: white; padding: 22px; border-radius: 8px; border: 1px solid #e2e8f0; }
.row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 10px; }
label { font-size: 0.8rem; font-weight: 700; color: #334155; display: block; margin-bottom: 4px; }
input, select { width: 100%; padding: 9px; border: 1.5px solid #cbd5e1; border-radius: 6px; }
.btn-primary { width: 100%; padding: 10px; background: #0284c7; color: white; border: none; border-radius: 6px; font-weight: 700; cursor: pointer; }
.srv-item { background: #f1f5f9; border-left: 4px solid #0284c7; padding: 12px; border-radius: 6px; margin-top: 10px; }
.toast { position: fixed; bottom: 20px; right: 20px; background: #0f172a; color: white; padding: 10px 18px; border-radius: 6px; display: none; }</code></pre>
        </div>

        <div class="sub-sec">
            <h4>6. SOURCE CODE: JAVASCRIPT (script.js)</h4>
            <pre><code>let tickets = [
    { id: &#x27;JOB-441&#x27;, model: &#x27;Lenovo ThinkPad E14&#x27;, issue: &#x27;RAM / NVMe SSD Speed Upgrade&#x27;, status: &#x27;Ready for Delivery&#x27; }
];
function showToast(m) { const t = document.getElementById(&#x27;toast&#x27;); t.innerText = m; t.style.display = &#x27;block&#x27;; setTimeout(() =&gt; t.style.display = &#x27;none&#x27;, 2500); }
function renderTickets() {
    document.getElementById(&#x27;serviceQueue&#x27;).innerHTML = tickets.map(t =&gt; `
        &lt;div class=&quot;srv-item&quot;&gt;
            &lt;div style=&quot;display:flex; justify-content:space-between; font-weight:700;&quot;&gt;
                &lt;span&gt;${t.id}: ${t.model}&lt;/span&gt;
                &lt;span style=&quot;color:#0284c7;&quot;&gt;${t.status}&lt;/span&gt;
            &lt;/div&gt;
            &lt;p style=&quot;font-size:0.85rem; color:#64748b;&quot;&gt;Issue: ${t.issue}&lt;/p&gt;
        &lt;/div&gt;
    `).join(&#x27;&#x27;);
}
function bookService(e) {
    e.preventDefault();
    const token = &#x27;JOB-&#x27; + Math.floor(400 + Math.random() * 599);
    tickets.unshift({
        id: token,
        model: document.getElementById(&#x27;lapModel&#x27;).value.trim(),
        issue: document.getElementById(&#x27;lapIssue&#x27;).value,
        status: &#x27;Assigned to Hardware Engineer&#x27;
    });
    showToast(`Service ticket created! Job Sheet: ${token}`);
    e.target.reset();
    renderTickets();
}
window.addEventListener(&#x27;DOMContentLoaded&#x27;, renderTickets);</code></pre>
        </div>

