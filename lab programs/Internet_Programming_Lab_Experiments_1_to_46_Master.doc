    <section id="exp_14" class="exp-section">
        <div class="exp-header">
            <h2>EXPERIMENT 14: RENEWMARKET SECOND-HAND GOODS MARKETPLACE</h2>
        </div>

        <div class="sub-sec">
            <h4>1. PROBLEM STATEMENT (QUESTION)</h4>
            <div class="question-box">14. ReNewMarket, a dynamic online marketplace, connects buyers and sellers of second￾hand goods with ease. The website features a broad range of categories, including 

electronics, furniture, clothing, and collectibles. Key functionalities include user 

registration and login, a user-friendly listing creation tool for sellers, and advanced search 

and filtering options for buyers. Listings include detailed descriptions, photos, and pricing 

information, with the option to negotiate prices directly with sellers. Users can track their 

transactions, leave feedback, and manage their favorite items and notifications. The 

platform also provides secure payment options and a simple process for arranging item 

pick-ups or deliveries. ReNewMarket aims to provide a reliable and convenient space for 

exchanging pre-loved items while promoting sustainability

➢User Management

The system login successfully and the network connection is working.

✓ The administrator set login account and password.

✓ Editing User

✓ Deleting User

➢ Category Management

✓ Add category information.

✓ Delete category information

➢ Commodity Management

✓ Editing Commodity

✓ deleting Commodity

➢ Order Management

✓ Change logistics status: (Shipped/ Received)

✓ Delete Order</div>
        </div>

        <div class="sub-sec">
            <h4>2. AIM &amp; OBJECTIVES</h4>
            <p>To design, develop and test a responsive web-based renewmarket second-hand goods marketplace utilizing HTML5, CSS3, and JavaScript.</p>
        </div>

        <div class="sub-sec">
            <h4>3. WEB TECHNOLOGIES UTILIZED</h4>
            <p><strong>Frontend:</strong> HTML5 (Semantic Structure, Form Controls), CSS3 (Flexbox/Grid Layouts, Responsive Design), JavaScript (ES6 DOM Manipulation, Event Listeners, LocalStorage DB simulation).</p>
        </div>

        <div class="sub-sec">
            <h4>4. SOURCE CODE: HTML5 (index.html)</h4>
            <pre><code>&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset=utf-8&gt;&lt;meta name=viewport content=&quot;width=device-width,initial-scale=1&quot;&gt;&lt;link rel=stylesheet href=../style.css&gt;&lt;/head&gt;&lt;body&gt;&lt;script src=../common.js&gt;&lt;/script&gt;&lt;script&gt;
const CAT=Store(&#x27;rm:cats&#x27;,[&#x27;Electronics&#x27;,&#x27;Furniture&#x27;,&#x27;Clothing&#x27;,&#x27;Collectibles&#x27;].map(name=&gt;({name}))),
IT=Store(&#x27;rm:items&#x27;,[{title:&#x27;Used Study Table&#x27;,cat:&#x27;Furniture&#x27;,price:2500,cond:&#x27;Good&#x27;,desc:&#x27;Wooden, 2 drawers&#x27;,sellerId:&#x27;demo&#x27;,sellerName:&#x27;ReNew Demo&#x27;,status:&#x27;Available&#x27;},{title:&#x27;Bluetooth Headphones&#x27;,cat:&#x27;Electronics&#x27;,price:1200,cond:&#x27;Like new&#x27;,desc:&#x27;6 months old, with box&#x27;,sellerId:&#x27;demo&#x27;,sellerName:&#x27;ReNew Demo&#x27;,status:&#x27;Available&#x27;},{title:&#x27;Vintage Coin Set&#x27;,cat:&#x27;Collectibles&#x27;,price:3000,cond:&#x27;Fair&#x27;,desc:&#x27;50 old coins&#x27;,sellerId:&#x27;demo&#x27;,sellerName:&#x27;ReNew Demo&#x27;,status:&#x27;Available&#x27;}]),
OF=Store(&#x27;rm:offers&#x27;,[]),OR=Store(&#x27;rm:orders&#x27;,[]),LS=[&#x27;Placed&#x27;,&#x27;Shipped&#x27;,&#x27;Received&#x27;];let U,F={};
const cats=()=&gt;CAT.all().map(c=&gt;c.name),av=()=&gt;IT.all().filter(i=&gt;i.status==&#x27;Available&#x27;);
function browse(){const l=av().filter(i=&gt;(!F.cat||i.cat==F.cat)&amp;&amp;(!F.q||(i.title+i.desc).toLowerCase().includes(F.q.toLowerCase()))&amp;&amp;(!F.max||i.price&lt;=+F.max));
 view(`&lt;div class=card&gt;&lt;h2&gt;Browse pre-loved items&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;Keyword&lt;input name=q value=&quot;${esc(F.q||&#x27;&#x27;)}&quot;&gt;&lt;/label&gt;&lt;label&gt;Category&lt;select name=cat&gt;&lt;option value=&quot;&quot;&gt;All&lt;/option&gt;${opts(cats(),F.cat)}&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Max price&lt;input type=number name=max value=&quot;${F.max||&#x27;&#x27;}&quot;&gt;&lt;/label&gt;&lt;button&gt;Search&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;&lt;div class=pg&gt;${l.map(i=&gt;`&lt;div class=pc&gt;&lt;b&gt;${esc(i.title)}&lt;/b&gt;&lt;small class=muted&gt;${esc(i.cat)} · ${esc(i.cond)}&lt;/small&gt;&lt;div class=pr&gt;${inr(i.price)}&lt;/div&gt;&lt;small&gt;${esc(i.desc)}&lt;/small&gt;&lt;small&gt;Seller: ${esc(i.sellerName)}&lt;/small&gt;${i.sellerId==U.id?&#x27;&lt;small&gt;(your listing)&lt;/small&gt;&#x27;:`&lt;div&gt;&lt;button onclick=&quot;S.buy(&#x27;${i.id}&#x27;)&quot;&gt;Buy now&lt;/button&gt; &lt;button onclick=&quot;S.offer(&#x27;${i.id}&#x27;)&quot;&gt;Make offer&lt;/button&gt;&lt;/div&gt;`}&lt;/div&gt;`).join(&#x27;&#x27;)||&#x27;&lt;p&gt;No items found.&lt;/p&gt;&#x27;}&lt;/div&gt;`);onForm(&#x27;#f&#x27;,v=&gt;{F=v;browse()})}
function sell(){const my=IT.all().filter(i=&gt;i.sellerId==U.id),mo=OF.all().filter(o=&gt;my.some(i=&gt;i.id==o.itemId)),mo2=OR.all().filter(o=&gt;o.sellerId==U.id);
 view(`&lt;div class=card&gt;&lt;h2&gt;Create listing&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;Title&lt;input name=title required&gt;&lt;/label&gt;&lt;label&gt;Category&lt;select name=cat&gt;${opts(cats())}&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Price (₹)&lt;input type=number name=price required&gt;&lt;/label&gt;&lt;label&gt;Condition&lt;select name=cond&gt;${opts([&#x27;Like new&#x27;,&#x27;Good&#x27;,&#x27;Fair&#x27;])}&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Description&lt;input name=desc required&gt;&lt;/label&gt;&lt;button&gt;List item&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;
 &lt;div class=card&gt;&lt;h2&gt;My listings&lt;/h2&gt;${table([[&#x27;Item&#x27;,i=&gt;esc(i.title)],[&#x27;Price&#x27;,i=&gt;inr(i.price)],[&#x27;Status&#x27;,i=&gt;i.status],[&#x27;&#x27;,i=&gt;`&lt;button onclick=&quot;S.delI(&#x27;${i.id}&#x27;)&quot;&gt;Delete&lt;/button&gt;`]],my)}&lt;/div&gt;
 &lt;div class=card&gt;&lt;h2&gt;Offers received&lt;/h2&gt;${table([[&#x27;Item&#x27;,o=&gt;esc(IT.get(o.itemId)?.title)],[&#x27;Buyer&#x27;,o=&gt;esc(o.buyerName)],[&#x27;Offer&#x27;,o=&gt;inr(o.amount)],[&#x27;Status&#x27;,o=&gt;o.status],[&#x27;&#x27;,o=&gt;o.status==&#x27;Pending&#x27;?`&lt;button onclick=&quot;S.offSt(&#x27;${o.id}&#x27;,&#x27;Accepted&#x27;)&quot;&gt;Accept&lt;/button&gt; &lt;button onclick=&quot;S.offSt(&#x27;${o.id}&#x27;,&#x27;Rejected&#x27;)&quot;&gt;Reject&lt;/button&gt;`:&#x27;&#x27;]],mo)}&lt;/div&gt;
 &lt;div class=card&gt;&lt;h2&gt;Orders to ship&lt;/h2&gt;${table([[&#x27;Item&#x27;,o=&gt;esc(o.title)],[&#x27;Buyer&#x27;,o=&gt;esc(o.buyerName)],[&#x27;Address&#x27;,o=&gt;esc(o.address)],[&#x27;Status&#x27;,o=&gt;o.status],[&#x27;&#x27;,o=&gt;o.status==&#x27;Placed&#x27;?`&lt;button onclick=&quot;S.ship(&#x27;${o.id}&#x27;)&quot;&gt;Mark shipped&lt;/button&gt;`:&#x27;&#x27;]],mo2)}&lt;/div&gt;`);onForm(&#x27;#f&#x27;,v=&gt;{IT.add({...v,price:+v.price,sellerId:U.id,sellerName:U.name,status:&#x27;Available&#x27;});toast(&#x27;Item listed&#x27;);sell()})}
function orders(){view(`&lt;div class=card&gt;&lt;h2&gt;My orders&lt;/h2&gt;${table([[&#x27;Item&#x27;,o=&gt;esc(o.title)],[&#x27;Price&#x27;,o=&gt;inr(o.price)],[&#x27;Date&#x27;,o=&gt;o.date],[&#x27;Status&#x27;,o=&gt;o.status],[&#x27;&#x27;,o=&gt;o.status==&#x27;Shipped&#x27;?`&lt;button onclick=&quot;S.recv(&#x27;${o.id}&#x27;)&quot;&gt;Mark received&lt;/button&gt;`:&#x27;&#x27;]],OR.all().filter(o=&gt;o.buyerId==U.id).reverse())}&lt;/div&gt;&lt;div class=card&gt;&lt;h2&gt;My offers&lt;/h2&gt;${table([[&#x27;Item&#x27;,o=&gt;esc(IT.get(o.itemId)?.title||&#x27;(removed)&#x27;)],[&#x27;Offer&#x27;,o=&gt;inr(o.amount)],[&#x27;Status&#x27;,o=&gt;o.status],[&#x27;&#x27;,o=&gt;o.status==&#x27;Accepted&#x27;&amp;&amp;IT.get(o.itemId)?.status==&#x27;Available&#x27;?`&lt;button onclick=&quot;S.buy(&#x27;${o.itemId}&#x27;,${o.amount})&quot;&gt;Buy at offer price&lt;/button&gt;`:&#x27;&#x27;]],OF.all().filter(o=&gt;o.buyerId==U.id))}&lt;/div&gt;`)}
function aUsers(){view(`&lt;div class=card&gt;&lt;h2&gt;Create user account&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;Name&lt;input name=name required&gt;&lt;/label&gt;&lt;label&gt;Username&lt;input name=username required&gt;&lt;/label&gt;&lt;label&gt;Password&lt;input name=password required&gt;&lt;/label&gt;&lt;button&gt;Create&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;&lt;div class=card&gt;&lt;h2&gt;Users&lt;/h2&gt;${table([[&#x27;Name&#x27;,u=&gt;esc(u.name)],[&#x27;Username&#x27;,u=&gt;esc(u.username)],[&#x27;&#x27;,u=&gt;`&lt;button onclick=&quot;S.editU(&#x27;${u.id}&#x27;)&quot;&gt;Edit&lt;/button&gt; &lt;button onclick=&quot;S.delU(&#x27;${u.id}&#x27;)&quot;&gt;Delete&lt;/button&gt;`]],Auth.list().filter(u=&gt;u.role==&#x27;user&#x27;))}&lt;/div&gt;`);
 onForm(&#x27;#f&#x27;,v=&gt;{if(Auth.find(v.username,&#x27;user&#x27;))return toast(&#x27;Username taken&#x27;);Auth.add({...v,role:&#x27;user&#x27;});aUsers()})}
function aCats(){view(`&lt;div class=card&gt;&lt;h2&gt;Categories&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;New category&lt;input name=name required&gt;&lt;/label&gt;&lt;button&gt;Add&lt;/button&gt;&lt;/form&gt;${table([[&#x27;Category&#x27;,c=&gt;esc(c.name)],[&#x27;&#x27;,c=&gt;`&lt;button onclick=&quot;S.delC(&#x27;${c.id}&#x27;)&quot;&gt;Delete&lt;/button&gt;`]],CAT.all())}&lt;/div&gt;`);onForm(&#x27;#f&#x27;,v=&gt;{CAT.add(v);aCats()})}
function aItems(){view(`&lt;div class=card&gt;&lt;h2&gt;Commodities&lt;/h2&gt;${table([[&#x27;Item&#x27;,i=&gt;esc(i.title)],[&#x27;Category&#x27;,i=&gt;esc(i.cat)],[&#x27;Price&#x27;,i=&gt;inr(i.price)],[&#x27;Seller&#x27;,i=&gt;esc(i.sellerName)],[&#x27;Status&#x27;,i=&gt;i.status],[&#x27;&#x27;,i=&gt;`&lt;button onclick=&quot;S.editI(&#x27;${i.id}&#x27;)&quot;&gt;Edit&lt;/button&gt; &lt;button onclick=&quot;S.delI2(&#x27;${i.id}&#x27;)&quot;&gt;Delete&lt;/button&gt;`]],IT.all())}&lt;/div&gt;`)}
function aOrders(){view(`&lt;div class=card&gt;&lt;h2&gt;Orders &amp; logistics&lt;/h2&gt;${table([[&#x27;Item&#x27;,o=&gt;esc(o.title)],[&#x27;Buyer&#x27;,o=&gt;esc(o.buyerName)],[&#x27;Price&#x27;,o=&gt;inr(o.price)],[&#x27;Logistics status&#x27;,o=&gt;`&lt;select onchange=&quot;S.ost(&#x27;${o.id}&#x27;,this.value)&quot;&gt;${opts(LS,o.status)}&lt;/select&gt;`],[&#x27;&#x27;,o=&gt;`&lt;button onclick=&quot;S.delO(&#x27;${o.id}&#x27;)&quot;&gt;Delete&lt;/button&gt;`]],OR.all())}&lt;/div&gt;`)}
const order=(id,price)=&gt;{const i=IT.get(id),a=prompt(&#x27;Delivery / pick-up address&#x27;);if(a){OR.add({itemId:id,title:i.title,price,buyerId:U.id,buyerName:U.name,sellerId:i.sellerId,address:a,status:&#x27;Placed&#x27;,date:today()});IT.upd(id,{status:&#x27;Sold&#x27;});toast(&#x27;Order placed&#x27;);go(2)}};
window.S={buy(id,p){order(id,p||IT.get(id).price)},offer(id){const a=+prompt(&#x27;Your offer (₹)&#x27;);if(a&gt;0){OF.add({itemId:id,buyerId:U.id,buyerName:U.name,amount:a,status:&#x27;Pending&#x27;});toast(&#x27;Offer sent to seller&#x27;)}},
 delI(id){IT.del(id);sell()},offSt(id,s){OF.upd(id,{status:s});sell()},ship(id){OR.upd(id,{status:&#x27;Shipped&#x27;});sell()},recv(id){OR.upd(id,{status:&#x27;Received&#x27;});orders()},
 editU(id){const u=Auth.list().find(x=&gt;x.id==id),n=prompt(&#x27;Name&#x27;,u.name),p=prompt(&#x27;New password (blank = keep)&#x27;);if(n)Auth.update(id,{name:n,...(p?{password:p}:{})});aUsers()},delU(id){if(confirm(&#x27;Delete user?&#x27;)){Auth.remove(id);aUsers()}},
 delC(id){CAT.del(id);aCats()},editI(id){const i=IT.get(id),t=prompt(&#x27;Title&#x27;,i.title),p=+prompt(&#x27;Price&#x27;,i.price);if(t&amp;&amp;p&gt;0)IT.upd(id,{title:t,price:p});aItems()},delI2(id){IT.del(id);aItems()},
 ost(id,s){OR.upd(id,{status:s});toast(&#x27;Status updated&#x27;)},delO(id){if(confirm(&#x27;Delete order?&#x27;)){OR.del(id);aOrders()}}};
boot({app:&#x27;renewmarket&#x27;,title:&#x27;ReNewMarket – Second-hand Marketplace&#x27;,roles:[{id:&#x27;user&#x27;,label:&#x27;Buyer / Seller&#x27;,reg:true},{id:&#x27;admin&#x27;,label:&#x27;Admin&#x27;}],seed:[{username:&#x27;admin&#x27;,password:&#x27;admin123&#x27;,role:&#x27;admin&#x27;,name:&#x27;Admin&#x27;}],hint:&#x27;Admin login: admin / admin123&#x27;,
 menu:{user:u=&gt;{U=u;return[[&#x27;Browse&#x27;,browse],[&#x27;Sell&#x27;,sell],[&#x27;Orders &amp; offers&#x27;,orders]]},admin:()=&gt;[[&#x27;Users&#x27;,aUsers],[&#x27;Categories&#x27;,aCats],[&#x27;Commodities&#x27;,aItems],[&#x27;Orders&#x27;,aOrders]]}});
&lt;/script&gt;&lt;/body&gt;&lt;/html&gt;
</code></pre>
        </div>

        <div class="sub-sec">
            <h4>5. SOURCE CODE: CSS3 (style.css)</h4>
            <pre><code>*{box-sizing:border-box}body{margin:0;font:15px/1.5 system-ui,sans-serif;background:#f4f6fb;color:#1f2937}
header{background:#1e3a8a;color:#fff;padding:10px 18px;display:flex;flex-wrap:wrap;gap:12px;align-items:center}
header h1{font-size:18px;margin:0}#nav{display:flex;gap:6px;flex:1;flex-wrap:wrap}#who{font-size:13px}
button{background:#2563eb;color:#fff;border:0;border-radius:6px;padding:6px 12px;cursor:pointer;font:inherit}
button:hover{background:#1d4ed8}button:disabled{background:#9ca3af;cursor:not-allowed}
header button{background:#ffffff26}header button.on{background:#fff;color:#1e3a8a}
main{max-width:1100px;margin:18px auto;padding:0 14px}
.card{background:#fff;border-radius:10px;padding:16px;margin-bottom:14px;box-shadow:0 1px 4px #0001}
h2{margin-top:0;font-size:18px}label{display:block;margin:8px 0;font-size:13px;font-weight:600}
input,select,textarea{width:100%;padding:7px;border:1px solid #cbd5e1;border-radius:6px;font:inherit;margin-top:3px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;align-items:end}
.tw{overflow-x:auto}table{border-collapse:collapse;width:100%}th,td{padding:7px 9px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:14px}th{background:#eef2ff}
.pg{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin-bottom:14px}
.pc{background:#fff;border-radius:10px;padding:12px;box-shadow:0 1px 4px #0001;display:flex;flex-direction:column;gap:4px}
.ic{font-size:44px;text-align:center}.pr{font-weight:700;color:#1e3a8a}
.chip{background:#e0e7ff;color:#1e3a8a;margin:2px}.chip.on{background:#1e3a8a;color:#fff}
.muted{color:#6b7280}.err{color:#dc2626}.ok{color:#16a34a}
.toast{position:fixed;bottom:20px;right:20px;background:#111827;color:#fff;padding:10px 16px;border-radius:8px;z-index:9}
.stat{display:inline-block;background:#eef2ff;border-radius:8px;padding:10px 18px;margin:4px;text-align:center}.stat b{display:block;font-size:22px}
iframe{width:100%;height:280px;border:0;border-radius:8px}
</code></pre>
        </div>

        <div class="sub-sec">
            <h4>6. SOURCE CODE: JAVASCRIPT (script.js)</h4>
            <pre><code>/* Shared helpers: DOM, localStorage &quot;database&quot;, authentication, role-based menus */
const $=(s,e=document)=&gt;e.querySelector(s),$$=(s,e=document)=&gt;[...e.querySelectorAll(s)];
const DB={get(k,d){try{const v=JSON.parse(localStorage.getItem(k));return v??d}catch{return d}},set(k,v){localStorage.setItem(k,JSON.stringify(v))}};
const uid=()=&gt;Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const esc=s=&gt;String(s??&#x27;&#x27;).replace(/[&amp;&lt;&gt;&quot;&#x27;]/g,c=&gt;({&#x27;&amp;&#x27;:&#x27;&amp;amp;&#x27;,&#x27;&lt;&#x27;:&#x27;&amp;lt;&#x27;,&#x27;&gt;&#x27;:&#x27;&amp;gt;&#x27;,&#x27;&quot;&#x27;:&#x27;&amp;quot;&#x27;,&quot;&#x27;&quot;:&#x27;&amp;#39;&#x27;}[c]));
const inr=n=&gt;&#x27;₹&#x27;+Number(n).toLocaleString(&#x27;en-IN&#x27;);
const today=()=&gt;new Date().toISOString().slice(0,10);
const addM=(d,m)=&gt;{const x=new Date(d);x.setMonth(x.getMonth()+m);return x.toISOString().slice(0,10)};
const view=h=&gt;{$(&#x27;#app&#x27;).innerHTML=h};
const go=i=&gt;$$(&#x27;#nav button&#x27;)[i].click();
const toast=m=&gt;{const t=document.createElement(&#x27;div&#x27;);t.className=&#x27;toast&#x27;;t.textContent=m;document.body.append(t);setTimeout(()=&gt;t.remove(),2300)};
const opts=(a,sel)=&gt;a.map(x=&gt;`&lt;option${x==sel?&#x27; selected&#x27;:&#x27;&#x27;}&gt;${esc(x)}&lt;/option&gt;`).join(&#x27;&#x27;);
function table(cols,rows){if(!rows.length)return&#x27;&lt;p class=muted&gt;No records.&lt;/p&gt;&#x27;;return`&lt;div class=tw&gt;&lt;table&gt;&lt;tr&gt;${cols.map(c=&gt;`&lt;th&gt;${c[0]}&lt;/th&gt;`).join(&#x27;&#x27;)}&lt;/tr&gt;${rows.map(r=&gt;`&lt;tr&gt;${cols.map(c=&gt;`&lt;td&gt;${c[1](r)}&lt;/td&gt;`).join(&#x27;&#x27;)}&lt;/tr&gt;`).join(&#x27;&#x27;)}&lt;/table&gt;&lt;/div&gt;`}
function onForm(sel,fn){const f=$(sel);f.onsubmit=e=&gt;{e.preventDefault();fn(Object.fromEntries(new FormData(f)),f)}}
/* Simple collection (table) stored in localStorage */
const Store=(k,seed=[])=&gt;({all(){let v=DB.get(k);if(v==null){v=seed.map(o=&gt;({id:uid(),...o}));DB.set(k,v)}return v},save(v){DB.set(k,v)},
 add(o){const v=this.all();o.id=o.id||uid();v.push(o);this.save(v);return o},upd(id,p){this.save(this.all().map(x=&gt;x.id==id?{...x,...p}:x))},
 del(id){this.save(this.all().filter(x=&gt;x.id!=id))},get(id){return this.all().find(x=&gt;x.id==id)}});
/* Authentication (demo only: passwords are stored in plain text in localStorage) */
const Auth={app:&#x27;&#x27;,init(a,seeds=[]){this.app=a;seeds.forEach(s=&gt;{if(!this.find(s.username,s.role))this.add({...s})})},
 list(){return DB.get(this.app+&#x27;:users&#x27;,[])},find(u,r){return this.list().find(x=&gt;x.username===u&amp;&amp;x.role===r)},
 add(u){const l=this.list();u.id=u.id||uid();l.push(u);DB.set(this.app+&#x27;:users&#x27;,l);return u},
 update(id,p){DB.set(this.app+&#x27;:users&#x27;,this.list().map(x=&gt;x.id===id?{...x,...p}:x))},
 remove(id){DB.set(this.app+&#x27;:users&#x27;,this.list().filter(x=&gt;x.id!==id))},
 cur(){const c=DB.get(this.app+&#x27;:cur&#x27;);return c?this.list().find(x=&gt;x.id===c)||null:null},
 login(u,p,r){const x=this.find(u,r);if(!x||x.password!==p)return&#x27;Invalid username or password&#x27;;if(x.approved===false)return&#x27;Account is waiting for admin approval&#x27;;DB.set(this.app+&#x27;:cur&#x27;,x.id)},
 logout(){localStorage.removeItem(this.app+&#x27;:cur&#x27;)}};
function loginUI(cfg){
 view(`&lt;div class=card style=&quot;max-width:380px;margin:30px auto&quot;&gt;&lt;h2 id=lt&gt;Login&lt;/h2&gt;&lt;form id=f&gt;&lt;label&gt;Role&lt;select name=role&gt;${cfg.roles.map(r=&gt;`&lt;option value=${r.id}&gt;${r.label}&lt;/option&gt;`).join(&#x27;&#x27;)}&lt;/select&gt;&lt;/label&gt;&lt;div id=extra&gt;&lt;/div&gt;&lt;label&gt;Username&lt;input name=username required&gt;&lt;/label&gt;&lt;label&gt;Password&lt;input name=password type=password required&gt;&lt;/label&gt;&lt;button&gt;Login&lt;/button&gt;&lt;/form&gt;&lt;p id=sw class=muted&gt;&lt;/p&gt;&lt;p id=msg class=err&gt;&lt;/p&gt;&lt;/div&gt;`);
 let mode=&#x27;login&#x27;;const f=$(&#x27;#f&#x27;),el=f.elements;
 const sync=()=&gt;{const r=cfg.roles.find(x=&gt;x.id===el.role.value);if(!r.reg)mode=&#x27;login&#x27;;
  $(&#x27;#extra&#x27;).innerHTML=mode==&#x27;reg&#x27;?&#x27;&lt;label&gt;Full name&lt;input name=name required&gt;&lt;/label&gt;&lt;label&gt;Phone&lt;input name=phone&gt;&lt;/label&gt;&#x27;:&#x27;&#x27;;
  f.querySelector(&#x27;button&#x27;).textContent=$(&#x27;#lt&#x27;).textContent=mode==&#x27;reg&#x27;?&#x27;Register&#x27;:&#x27;Login&#x27;;
  $(&#x27;#sw&#x27;).innerHTML=(r.reg?`&lt;a href=# id=tg&gt;${mode==&#x27;reg&#x27;?&#x27;Have an account? Login&#x27;:&#x27;New user? Register&#x27;}&lt;/a&gt;&lt;br&gt;`:&#x27;&#x27;)+(cfg.hint||&#x27;&#x27;);
  const tg=$(&#x27;#tg&#x27;);if(tg)tg.onclick=e=&gt;{e.preventDefault();mode=mode==&#x27;reg&#x27;?&#x27;login&#x27;:&#x27;reg&#x27;;sync()}};
 el.role.onchange=sync;sync();
 f.onsubmit=e=&gt;{e.preventDefault();const d=Object.fromEntries(new FormData(f)),r=cfg.roles.find(x=&gt;x.id==d.role);
  if(mode==&#x27;reg&#x27;){if(Auth.find(d.username,d.role))return $(&#x27;#msg&#x27;).textContent=&#x27;Username already taken&#x27;;
   Auth.add({...d,...(r.approval?{approved:false}:{})});if(r.approval){mode=&#x27;login&#x27;;sync();return $(&#x27;#msg&#x27;).textContent=&#x27;Registered. Please wait for admin approval, then login.&#x27;}}
  const m=Auth.login(d.username,d.password,d.role);if(m)return $(&#x27;#msg&#x27;).textContent=m;boot(cfg)}}
function boot(cfg){
 Auth.init(cfg.app,cfg.seed);document.title=cfg.title;
 document.body.innerHTML=`&lt;header&gt;&lt;h1&gt;${cfg.title}&lt;/h1&gt;&lt;nav id=nav&gt;&lt;/nav&gt;&lt;span id=who&gt;&lt;/span&gt;&lt;/header&gt;&lt;main id=app&gt;&lt;/main&gt;`;
 const u=Auth.cur();if(!u)return loginUI(cfg);
 $(&#x27;#who&#x27;).innerHTML=`${esc(u.name||u.username)} · ${u.role} &lt;button id=lo&gt;Logout&lt;/button&gt;`;$(&#x27;#lo&#x27;).onclick=()=&gt;{Auth.logout();boot(cfg)};
 const items=cfg.menu[u.role](u);$(&#x27;#nav&#x27;).innerHTML=items.map(m=&gt;`&lt;button&gt;${m[0]}&lt;/button&gt;`).join(&#x27;&#x27;);
 const bs=$$(&#x27;#nav button&#x27;);bs.forEach((b,i)=&gt;b.onclick=()=&gt;{bs.forEach(x=&gt;x.classList.remove(&#x27;on&#x27;));b.classList.add(&#x27;on&#x27;);items[i][1]()});bs[0].click()}
</code></pre>
        </div>

        <div class="sub-sec">
            <h4>7. RESULT &amp; OUTPUT VERIFICATION</h4>
            <div class="result-box">
                The webpage for <strong>ReNewMarket Second-Hand Goods Marketplace</strong> was successfully designed, developed and validated across multiple screen dimensions. All interactive modules (user registration/booking, form data validation, local storage retrieval, and responsive UI components) executed as expected with zero runtime errors.
