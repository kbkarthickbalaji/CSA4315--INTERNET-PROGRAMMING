            &lt;div class=&quot;skill-bar&quot;&gt;&lt;span&gt;CSS3 Flexbox, Grid &amp;amp; Media Queries&lt;/span&gt;&lt;div class=&quot;track&quot;&gt;&lt;div class=&quot;fill&quot; style=&quot;width:90%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;
