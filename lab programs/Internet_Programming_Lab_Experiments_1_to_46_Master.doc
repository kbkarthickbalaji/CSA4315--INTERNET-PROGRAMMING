const today=()=&gt;new Date().toISOString().slice(0,10);
const addM=(d,m)=&gt;{const x=new Date(d);x.setMonth(x.getMonth()+m);return x.toISOString().slice(0,10)};
const view=h=&gt;{$(&#x27;#app&#x27;).innerHTML=h};
const go=i=&gt;$$(&#x27;#nav button&#x27;)[i].click();
const toast=m=&gt;{const t=document.createElement(&#x27;div&#x27;);t.className=&#x27;toast&#x27;;t.textContent=m;document.body.append(t);setTimeout(()=&gt;t.remove(),2300)};
const opts=(a,sel)=&gt;a.map(x=&gt;`&lt;option${x==sel?&#x27; selected&#x27;:&#x27;&#x27;}&gt;${esc(x)}&lt;/option&gt;`).join(&#x27;&#x27;);
function table(cols,rows){if(!rows.length)return&#x27;&lt;p class=muted&gt;No records.&lt;/p&gt;&#x27;;return`&lt;div class=tw&gt;&lt;table&gt;&lt;tr&gt;${cols.map(c=&gt;`&lt;th&gt;${c[0]}&lt;/th&gt;`).join(&#x27;&#x27;)}&lt;/tr&gt;${rows.map(r=&gt;`&lt;tr&gt;${cols.map(c=&gt;`&lt;td&gt;${c[1](r)}&lt;/td&gt;`).join(&#x27;&#x27;)}&lt;/tr&gt;`).join(&#x27;&#x27;)}&lt;/table&gt;&lt;/div&gt;`}
function onForm(sel,fn){const f=$(sel);f.onsubmit=e=&gt;{e.preventDefault();fn(Object.fromEntries(new FormData(f)),f)}}
/* Simple collection (table) stored in localStorage */
const Store=(k,seed=[])=&gt;({all(){let v=DB.get(k);if(v==null){v=seed.map(o=&gt;({id:uid(),...o}));DB.set(k,v)}return v},save(v){DB.set(k,v)},
 add(o){const v=this.all();o.id=o.id||uid();v.push(o);this.save(v);return o},upd(id,p){this.save(this.all().map(x=&gt;x.id==id?{...x,...p}:x))},
 del(id){this.save(this.all().filter(x=&gt;x.id!=id))},get(id){return this.all().find(x=&gt;x.id==id)}});
/* Authentication (demo only: passwords are stored in plain text in localStorage) */
const Auth={app:&#x27;&#x27;,init(a,seeds=[]){this.app=a;seeds.forEach(s=&gt;{if(!this.find(s.username,s.role))this.add({...s})})},
 list(){return DB.get(this.app+&#x27;:users&#x27;,[])},find(u,r){return this.list().find(x=&gt;x.username===u&amp;&amp;x.role===r)},
 add(u){const l=this.list();u.id=u.id||uid();l.push(u);DB.set(this.app+&#x27;:users&#x27;,l);return u},
 update(id,p){DB.set(this.app+&#x27;:users&#x27;,this.list().map(x=&gt;x.id===id?{...x,...p}:x))},
 remove(id){DB.set(this.app+&#x27;:users&#x27;,this.list().filter(x=&gt;x.id!==id))},
 cur(){const c=DB.get(this.app+&#x27;:cur&#x27;);return c?this.list().find(x=&gt;x.id===c)||null:null},
 login(u,p,r){const x=this.find(u,r);if(!x||x.password!==p)return&#x27;Invalid username or password&#x27;;if(x.approved===false)return&#x27;Account is waiting for admin approval&#x27;;DB.set(this.app+&#x27;:cur&#x27;,x.id)},
 logout(){localStorage.removeItem(this.app+&#x27;:cur&#x27;)}};
function loginUI(cfg){
 view(`&lt;div class=card style=&quot;max-width:380px;margin:30px auto&quot;&gt;&lt;h2 id=lt&gt;Login&lt;/h2&gt;&lt;form id=f&gt;&lt;label&gt;Role&lt;select name=role&gt;${cfg.roles.map(r=&gt;`&lt;option value=${r.id}&gt;${r.label}&lt;/option&gt;`).join(&#x27;&#x27;)}&lt;/select&gt;&lt;/label&gt;&lt;div id=extra&gt;&lt;/div&gt;&lt;label&gt;Username&lt;input name=username required&gt;&lt;/label&gt;&lt;label&gt;Password&lt;input name=password type=password required&gt;&lt;/label&gt;&lt;button&gt;Login&lt;/button&gt;&lt;/form&gt;&lt;p id=sw class=muted&gt;&lt;/p&gt;&lt;p id=msg class=err&gt;&lt;/p&gt;&lt;/div&gt;`);
 let mode=&#x27;login&#x27;;const f=$(&#x27;#f&#x27;),el=f.elements;
 const sync=()=&gt;{const r=cfg.roles.find(x=&gt;x.id===el.role.value);if(!r.reg)mode=&#x27;login&#x27;;
  $(&#x27;#extra&#x27;).innerHTML=mode==&#x27;reg&#x27;?&#x27;&lt;label&gt;Full name&lt;input name=name required&gt;&lt;/label&gt;&lt;label&gt;Phone&lt;input name=phone&gt;&lt;/label&gt;&#x27;:&#x27;&#x27;;
  f.querySelector(&#x27;button&#x27;).textContent=$(&#x27;#lt&#x27;).textContent=mode==&#x27;reg&#x27;?&#x27;Register&#x27;:&#x27;Login&#x27;;
  $(&#x27;#sw&#x27;).innerHTML=(r.reg?`&lt;a href=# id=tg&gt;${mode==&#x27;reg&#x27;?&#x27;Have an account? Login&#x27;:&#x27;New user? Register&#x27;}&lt;/a&gt;&lt;br&gt;`:&#x27;&#x27;)+(cfg.hint||&#x27;&#x27;);
  const tg=$(&#x27;#tg&#x27;);if(tg)tg.onclick=e=&gt;{e.preventDefault();mode=mode==&#x27;reg&#x27;?&#x27;login&#x27;:&#x27;reg&#x27;;sync()}};
 el.role.onchange=sync;sync();
 f.onsubmit=e=&gt;{e.preventDefault();const d=Object.fromEntries(new FormData(f)),r=cfg.roles.find(x=&gt;x.id==d.role);
  if(mode==&#x27;reg&#x27;){if(Auth.find(d.username,d.role))return $(&#x27;#msg&#x27;).textContent=&#x27;Username already taken&#x27;;
   Auth.add({...d,...(r.approval?{approved:false}:{})});if(r.approval){mode=&#x27;login&#x27;;sync();return $(&#x27;#msg&#x27;).textContent=&#x27;Registered. Please wait for admin approval, then login.&#x27;}}
  const m=Auth.login(d.username,d.password,d.role);if(m)return $(&#x27;#msg&#x27;).textContent=m;boot(cfg)}}
function boot(cfg){
 Auth.init(cfg.app,cfg.seed);document.title=cfg.title;
 document.body.innerHTML=`&lt;header&gt;&lt;h1&gt;${cfg.title}&lt;/h1&gt;&lt;nav id=nav&gt;&lt;/nav&gt;&lt;span id=who&gt;&lt;/span&gt;&lt;/header&gt;&lt;main id=app&gt;&lt;/main&gt;`;
 const u=Auth.cur();if(!u)return loginUI(cfg);
 $(&#x27;#who&#x27;).innerHTML=`${esc(u.name||u.username)} · ${u.role} &lt;button id=lo&gt;Logout&lt;/button&gt;`;$(&#x27;#lo&#x27;).onclick=()=&gt;{Auth.logout();boot(cfg)};
 const items=cfg.menu[u.role](u);$(&#x27;#nav&#x27;).innerHTML=items.map(m=&gt;`&lt;button&gt;${m[0]}&lt;/button&gt;`).join(&#x27;&#x27;);
 const bs=$$(&#x27;#nav button&#x27;);bs.forEach((b,i)=&gt;b.onclick=()=&gt;{bs.forEach(x=&gt;x.classList.remove(&#x27;on&#x27;));b.classList.add(&#x27;on&#x27;);items[i][1]()});bs[0].click()}
</code></pre>
        </div>

        <div class="sub-sec">
            <h4>7. RESULT &amp; OUTPUT VERIFICATION</h4>
            <div class="result-box">
                The webpage for <strong>StyleHub Fashion E-Commerce</strong> was successfully designed, developed and validated across multiple screen dimensions. All interactive modules (user registration/booking, form data validation, local storage retrieval, and responsive UI components) executed as expected with zero runtime errors.
            </div>
        </div>
    </section>
    
    <section id="exp_11" class="exp-section">
        <div class="exp-header">
            <h2>EXPERIMENT 11: HOME FINDER REAL ESTATE PLATFORM</h2>
        </div>

        <div class="sub-sec">
            <h4>1. PROBLEM STATEMENT (QUESTION)</h4>
            <div class="question-box">11. Home Finder, an innovative online real estate platform, is designed to simplify the 

property search and transaction process for buyers, sellers, and renters. The website 

features a comprehensive database of residential and commercial properties, with 

advanced search filters for location, price, type, and amenities. Key functionalities include 

user registration and login, detailed property listings with high-quality images and virtual 

tours, and interactive maps to explore neighborhood features. Users can schedule 

property viewings, save favorite listings, and receive notifications for new or updated 

properties matching their criteria. The platform also offers tools for property valuation, 

mortgage calculators, and direct communication with real estate agents. Home Finder 

aims to make the property search process efficient and transparent, providing users with 

valuable. This website helps the user to search and book lands/houses in their required 

area in their budget.

➢ Provide a login page for buyers and store their username and password in the database

and can save the search criteria for the buyers.

➢ Helps the buyers to use the same search criteria rather than creating a new criterion

every time the buyer performs the search.

➢ Add more advertisements on the website or links to another website.

➢ Add agent and company search functionality.

➢ Displaying the search results on Google Maps and locating the area where the property

listing is located.

➢ It should be friendly and pretty

➢ Store and give details of properties

➢ Maintain record of customers visited the website</div>
        </div>

        <div class="sub-sec">
            <h4>2. AIM &amp; OBJECTIVES</h4>
            <p>To design, develop and test a responsive web-based home finder real estate platform utilizing HTML5, CSS3, and JavaScript.</p>
        </div>

        <div class="sub-sec">
            <h4>3. WEB TECHNOLOGIES UTILIZED</h4>
            <p><strong>Frontend:</strong> HTML5 (Semantic Structure, Form Controls), CSS3 (Flexbox/Grid Layouts, Responsive Design), JavaScript (ES6 DOM Manipulation, Event Listeners, LocalStorage DB simulation).</p>
        </div>

        <div class="sub-sec">
            <h4>4. SOURCE CODE: HTML5 (index.html)</h4>
            <pre><code>&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset=utf-8&gt;&lt;meta name=viewport content=&quot;width=device-width,initial-scale=1&quot;&gt;&lt;link rel=stylesheet href=../style.css&gt;&lt;/head&gt;&lt;body&gt;&lt;script src=../common.js&gt;&lt;/script&gt;&lt;script&gt;
const P=Store(&#x27;hf:props&#x27;,[
{title:&#x27;3BHK Villa&#x27;,type:&#x27;House&#x27;,listing:&#x27;Sale&#x27;,location:&#x27;Chennai&#x27;,price:9500000,beds:3,area:1800,agent:&#x27;Ravi Kumar&#x27;,desc:&#x27;Gated community villa with garden.&#x27;},
{title:&#x27;2BHK Apartment&#x27;,type:&#x27;Apartment&#x27;,listing:&#x27;Rent&#x27;,location:&#x27;Bengaluru&#x27;,price:28000,beds:2,area:1100,agent:&#x27;Divya S&#x27;,desc:&#x27;Near metro, covered parking.&#x27;},
{title:&#x27;DTCP Approved Plot&#x27;,type:&#x27;Land&#x27;,listing:&#x27;Sale&#x27;,location:&#x27;Coimbatore&#x27;,price:3200000,beds:0,area:2400,agent:&#x27;Ravi Kumar&#x27;,desc:&#x27;Corner plot, 40 ft road.&#x27;},
{title:&#x27;Office Space&#x27;,type:&#x27;Commercial&#x27;,listing:&#x27;Rent&#x27;,location:&#x27;Chennai&#x27;,price:65000,beds:0,area:1500,agent:&#x27;Divya S&#x27;,desc:&#x27;Furnished, IT corridor.&#x27;},
{title:&#x27;1BHK Flat&#x27;,type:&#x27;Apartment&#x27;,listing:&#x27;Rent&#x27;,location:&#x27;Madurai&#x27;,price:12000,beds:1,area:650,agent:&#x27;Ravi Kumar&#x27;,desc:&#x27;Close to bus stand.&#x27;},
{title:&#x27;4BHK Duplex&#x27;,type:&#x27;House&#x27;,listing:&#x27;Sale&#x27;,location:&#x27;Hyderabad&#x27;,price:14500000,beds:4,area:2600,agent:&#x27;Divya S&#x27;,desc:&#x27;Premium duplex with terrace.&#x27;}]);
const AG=Store(&#x27;hf:agents&#x27;,[{name:&#x27;Ravi Kumar&#x27;,company:&#x27;Prime Realty&#x27;,phone:&#x27;9840000001&#x27;,email:&#x27;ravi@primerealty.in&#x27;},{name:&#x27;Divya S&#x27;,company:&#x27;HomeNest&#x27;,phone:&#x27;9840000002&#x27;,email:&#x27;divya@homenest.in&#x27;}]);
const V=Store(&#x27;hf:views&#x27;,[]),L=Store(&#x27;hf:log&#x27;,[]);
const IC={House:&#x27;🏠&#x27;,Apartment:&#x27;🏢&#x27;,Land:&#x27;🌳&#x27;,Commercial:&#x27;🏬&#x27;};let U,F={};
const sk=()=&gt;&#x27;hf:saved:&#x27;+U.id,fk=()=&gt;&#x27;hf:fav:&#x27;+U.id;
const pcard=p=&gt;`&lt;div class=pc&gt;&lt;div class=ic&gt;${IC[p.type]}&lt;/div&gt;&lt;b&gt;${esc(p.title)}&lt;/b&gt;&lt;small class=muted&gt;${esc(p.type)} for ${p.listing} · ${esc(p.location)}&lt;/small&gt;&lt;div class=pr&gt;${inr(p.price)}${p.listing==&#x27;Rent&#x27;?&#x27;/mo&#x27;:&#x27;&#x27;}&lt;/div&gt;&lt;small&gt;${p.beds?p.beds+&#x27; BHK · &#x27;:&#x27;&#x27;}${p.area} sq.ft · Agent: ${esc(p.agent)}&lt;/small&gt;&lt;small&gt;${esc(p.desc)}&lt;/small&gt;&lt;div&gt;&lt;button onclick=&quot;S.map(&#x27;${p.id}&#x27;)&quot;&gt;Map&lt;/button&gt; &lt;button onclick=&quot;S.visit(&#x27;${p.id}&#x27;)&quot;&gt;Visit&lt;/button&gt; &lt;button onclick=&quot;S.fav(&#x27;${p.id}&#x27;)&quot;&gt;${DB.get(fk(),[]).includes(p.id)?&#x27;♥&#x27;:&#x27;♡&#x27;}&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;`;
function search(){const l=P.all().filter(p=&gt;(!F.location||p.location.toLowerCase().includes(F.location.toLowerCase()))&amp;&amp;(!F.type||p.type==F.type)&amp;&amp;(!F.listing||p.listing==F.listing)&amp;&amp;(!F.max||p.price&lt;=+F.max)&amp;&amp;(!F.beds||p.beds&gt;=+F.beds));
 view(`&lt;div class=card&gt;&lt;h2&gt;Search properties&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;Location&lt;input name=location value=&quot;${esc(F.location||&#x27;&#x27;)}&quot;&gt;&lt;/label&gt;&lt;label&gt;Type&lt;select name=type&gt;&lt;option value=&quot;&quot;&gt;Any&lt;/option&gt;${opts(Object.keys(IC),F.type)}&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Buy / Rent&lt;select name=listing&gt;&lt;option value=&quot;&quot;&gt;Any&lt;/option&gt;${opts([&#x27;Sale&#x27;,&#x27;Rent&#x27;],F.listing)}&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Max price (₹)&lt;input type=number name=max value=&quot;${F.max||&#x27;&#x27;}&quot;&gt;&lt;/label&gt;&lt;label&gt;Min bedrooms&lt;input type=number name=beds value=&quot;${F.beds||&#x27;&#x27;}&quot;&gt;&lt;/label&gt;&lt;button&gt;Search&lt;/button&gt;&lt;button type=button onclick=&quot;S.save()&quot;&gt;Save criteria&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;&lt;div class=pg&gt;${l.map(pcard).join(&#x27;&#x27;)||&#x27;&lt;p&gt;No properties match.&lt;/p&gt;&#x27;}&lt;/div&gt;`);
 onForm(&#x27;#f&#x27;,v=&gt;{F=v;search()})}
function saved(){const s=DB.get(sk(),[]);view(`&lt;div class=card&gt;&lt;h2&gt;Saved search criteria&lt;/h2&gt;${table([[&#x27;Name&#x27;,x=&gt;esc(x.name)],[&#x27;Criteria&#x27;,x=&gt;esc(Object.entries(x.f).filter(e=&gt;e[1]).map(e=&gt;e[0]+&#x27;: &#x27;+e[1]).join(&#x27;, &#x27;)||&#x27;any&#x27;)],[&#x27;&#x27;,(x,i)=&gt;`&lt;button onclick=&quot;S.apply(&#x27;${x.name}&#x27;)&quot;&gt;Apply&lt;/button&gt; &lt;button onclick=&quot;S.rmSaved(&#x27;${x.name}&#x27;)&quot;&gt;Delete&lt;/button&gt;`]],s)}&lt;/div&gt;`)}
function favs(){view(`&lt;h2&gt;Favourite listings&lt;/h2&gt;&lt;div class=pg&gt;${DB.get(fk(),[]).map(id=&gt;P.get(id)).filter(Boolean).map(pcard).join(&#x27;&#x27;)||&#x27;&lt;p&gt;No favourites yet.&lt;/p&gt;&#x27;}&lt;/div&gt;`)}
function views(){view(`&lt;div class=card&gt;&lt;h2&gt;My viewing requests&lt;/h2&gt;${table([[&#x27;Property&#x27;,v=&gt;esc(v.title)],[&#x27;Date&#x27;,v=&gt;esc(v.date)]],V.all().filter(v=&gt;v.userId==U.id))}&lt;/div&gt;`)}
function agents(){const q=(F.aq||&#x27;&#x27;).toLowerCase();view(`&lt;div class=card&gt;&lt;h2&gt;Find agent / company&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;Name or company&lt;input name=aq value=&quot;${esc(F.aq||&#x27;&#x27;)}&quot;&gt;&lt;/label&gt;&lt;button&gt;Search&lt;/button&gt;&lt;/form&gt;${table([[&#x27;Agent&#x27;,a=&gt;esc(a.name)],[&#x27;Company&#x27;,a=&gt;esc(a.company)],[&#x27;Phone&#x27;,a=&gt;esc(a.phone)],[&#x27;Email&#x27;,a=&gt;esc(a.email)]],AG.all().filter(a=&gt;(a.name+a.company).toLowerCase().includes(q)))}&lt;/div&gt;`);onForm(&#x27;#f&#x27;,v=&gt;{F.aq=v.aq;agents()})}
function calc(){view(`&lt;div class=card style=&quot;max-width:420px&quot;&gt;&lt;h2&gt;Mortgage calculator&lt;/h2&gt;&lt;form id=f&gt;&lt;label&gt;Loan amount (₹)&lt;input type=number name=p required&gt;&lt;/label&gt;&lt;label&gt;Interest rate (% p.a.)&lt;input type=number step=0.1 name=r value=8.5 required&gt;&lt;/label&gt;&lt;label&gt;Tenure (years)&lt;input type=number name=y value=20 required&gt;&lt;/label&gt;&lt;button&gt;Calculate EMI&lt;/button&gt;&lt;/form&gt;&lt;h3 id=o&gt;&lt;/h3&gt;&lt;/div&gt;`);
 onForm(&#x27;#f&#x27;,v=&gt;{const r=v.r/1200,n=v.y*12,e=v.p*r*Math.pow(1+r,n)/(Math.pow(1+r,n)-1);$(&#x27;#o&#x27;).textContent=&#x27;Monthly EMI: &#x27;+inr(Math.round(e))+&#x27; · Total: &#x27;+inr(Math.round(e*n))})}
function aProps(){view(`&lt;div class=card&gt;&lt;h2&gt;Add property&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;Title&lt;input name=title required&gt;&lt;/label&gt;&lt;label&gt;Type&lt;select name=type&gt;${opts(Object.keys(IC))}&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Sale / Rent&lt;select name=listing&gt;${opts([&#x27;Sale&#x27;,&#x27;Rent&#x27;])}&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Location&lt;input name=location required&gt;&lt;/label&gt;&lt;label&gt;Price&lt;input type=number name=price required&gt;&lt;/label&gt;&lt;label&gt;Bedrooms&lt;input type=number name=beds value=0&gt;&lt;/label&gt;&lt;label&gt;Area (sq.ft)&lt;input type=number name=area required&gt;&lt;/label&gt;&lt;label&gt;Agent&lt;select name=agent&gt;${opts(AG.all().map(a=&gt;a.name))}&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Description&lt;input name=desc&gt;&lt;/label&gt;&lt;button&gt;Add&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;&lt;div class=card&gt;&lt;h2&gt;Properties&lt;/h2&gt;${table([[&#x27;Title&#x27;,p=&gt;esc(p.title)],[&#x27;Type&#x27;,p=&gt;p.type+&#x27; / &#x27;+p.listing],[&#x27;Location&#x27;,p=&gt;esc(p.location)],[&#x27;Price&#x27;,p=&gt;inr(p.price)],[&#x27;Agent&#x27;,p=&gt;esc(p.agent)],[&#x27;&#x27;,p=&gt;`&lt;button onclick=&quot;S.delP(&#x27;${p.id}&#x27;)&quot;&gt;Delete&lt;/button&gt;`]],P.all())}&lt;/div&gt;`);
 onForm(&#x27;#f&#x27;,v=&gt;{P.add({...v,price:+v.price,beds:+v.beds,area:+v.area});aProps()})}
function aAgents(){view(`&lt;div class=card&gt;&lt;h2&gt;Add agent / company&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;Name&lt;input name=name required&gt;&lt;/label&gt;&lt;label&gt;Company&lt;input name=company required&gt;&lt;/label&gt;&lt;label&gt;Phone&lt;input name=phone required&gt;&lt;/label&gt;&lt;label&gt;Email&lt;input name=email type=email required&gt;&lt;/label&gt;&lt;button&gt;Add&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;&lt;div class=card&gt;${table([[&#x27;Agent&#x27;,a=&gt;esc(a.name)],[&#x27;Company&#x27;,a=&gt;esc(a.company)],[&#x27;Phone&#x27;,a=&gt;esc(a.phone)],[&#x27;Email&#x27;,a=&gt;esc(a.email)],[&#x27;&#x27;,a=&gt;`&lt;button onclick=&quot;S.delA(&#x27;${a.id}&#x27;)&quot;&gt;Delete&lt;/button&gt;`]],AG.all())}&lt;/div&gt;`);onForm(&#x27;#f&#x27;,v=&gt;{AG.add(v);aAgents()})}
function aCust(){view(`&lt;div class=card&gt;&lt;h2&gt;Registered buyers&lt;/h2&gt;${table([[&#x27;Name&#x27;,u=&gt;esc(u.name)],[&#x27;Username&#x27;,u=&gt;esc(u.username)],[&#x27;Phone&#x27;,u=&gt;esc(u.phone||&#x27;-&#x27;)]],Auth.list().filter(u=&gt;u.role==&#x27;buyer&#x27;))}&lt;/div&gt;&lt;div class=card&gt;&lt;h2&gt;Website visit log&lt;/h2&gt;${table([[&#x27;Customer&#x27;,l=&gt;esc(l.user)],[&#x27;Visited at&#x27;,l=&gt;esc(l.time)]],L.all().slice().reverse())}&lt;/div&gt;&lt;div class=card&gt;&lt;h2&gt;Viewing requests&lt;/h2&gt;${table([[&#x27;Customer&#x27;,v=&gt;esc(v.userName)],[&#x27;Property&#x27;,v=&gt;esc(v.title)],[&#x27;Date&#x27;,v=&gt;esc(v.date)]],V.all())}&lt;/div&gt;`)}
window.S={save(){const n=prompt(&#x27;Name for this search&#x27;);if(n){DB.set(sk(),[...DB.get(sk(),[]).filter(x=&gt;x.name!=n),{name:n,f:F}]);toast(&#x27;Criteria saved&#x27;)}},
 apply(n){F=DB.get(sk(),[]).find(x=&gt;x.name==n).f;go(0)},rmSaved(n){DB.set(sk(),DB.get(sk(),[]).filter(x=&gt;x.name!=n));saved()},
 fav(id){const f=DB.get(fk(),[]);DB.set(fk(),f.includes(id)?f.filter(x=&gt;x!=id):[...f,id]);search()},
 visit(id){const d=prompt(&#x27;Preferred viewing date (YYYY-MM-DD)&#x27;,today());if(d){V.add({propId:id,title:P.get(id).title,userId:U.id,userName:U.name,date:d});toast(&#x27;Viewing requested&#x27;)}},
 map(id){const p=P.get(id);view(`&lt;div class=card&gt;&lt;button onclick=&quot;go(0)&quot;&gt;← Back&lt;/button&gt;&lt;h2&gt;${esc(p.title)} – ${esc(p.location)}&lt;/h2&gt;&lt;iframe src=&quot;https://maps.google.com/maps?q=${encodeURIComponent(p.title+&#x27; &#x27;+p.location)}&amp;output=embed&quot;&gt;&lt;/iframe&gt;&lt;/div&gt;`)},
 delP(id){P.del(id);aProps()},delA(id){AG.del(id);aAgents()}};
boot({app:&#x27;homefinder&#x27;,title:&#x27;Home Finder – Property Portal&#x27;,roles:[{id:&#x27;buyer&#x27;,label:&#x27;Buyer / Renter&#x27;,reg:true},{id:&#x27;admin&#x27;,label:&#x27;Admin&#x27;}],seed:[{username:&#x27;admin&#x27;,password:&#x27;admin123&#x27;,role:&#x27;admin&#x27;,name:&#x27;Admin&#x27;}],hint:&#x27;Admin login: admin / admin123&#x27;,
 menu:{buyer:u=&gt;{U=u;if(!sessionStorage.hf){L.add({user:u.name,time:new Date().toLocaleString()});sessionStorage.hf=1}return[[&#x27;Search&#x27;,search],[&#x27;Saved searches&#x27;,saved],[&#x27;Favourites&#x27;,favs],[&#x27;Viewings&#x27;,views],[&#x27;Agents&#x27;,agents],[&#x27;Mortgage calc&#x27;,calc]]},admin:()=&gt;[[&#x27;Properties&#x27;,aProps],[&#x27;Agents&#x27;,aAgents],[&#x27;Customers &amp; visits&#x27;,aCust]]}});
&lt;/script&gt;&lt;/body&gt;&lt;/html&gt;
</code></pre>
        </div>

        <div class="sub-sec">
            <h4>5. SOURCE CODE: CSS3 (style.css)</h4>
            <pre><code>*{box-sizing:border-box}body{margin:0;font:15px/1.5 system-ui,sans-serif;background:#f4f6fb;color:#1f2937}
header{background:#1e3a8a;color:#fff;padding:10px 18px;display:flex;flex-wrap:wrap;gap:12px;align-items:center}
header h1{font-size:18px;margin:0}#nav{display:flex;gap:6px;flex:1;flex-wrap:wrap}#who{font-size:13px}
button{background:#2563eb;color:#fff;border:0;border-radius:6px;padding:6px 12px;cursor:pointer;font:inherit}
button:hover{background:#1d4ed8}button:disabled{background:#9ca3af;cursor:not-allowed}
header button{background:#ffffff26}header button.on{background:#fff;color:#1e3a8a}
main{max-width:1100px;margin:18px auto;padding:0 14px}
.card{background:#fff;border-radius:10px;padding:16px;margin-bottom:14px;box-shadow:0 1px 4px #0001}
h2{margin-top:0;font-size:18px}label{display:block;margin:8px 0;font-size:13px;font-weight:600}
input,select,textarea{width:100%;padding:7px;border:1px solid #cbd5e1;border-radius:6px;font:inherit;margin-top:3px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;align-items:end}
.tw{overflow-x:auto}table{border-collapse:collapse;width:100%}th,td{padding:7px 9px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:14px}th{background:#eef2ff}
.pg{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin-bottom:14px}
.pc{background:#fff;border-radius:10px;padding:12px;box-shadow:0 1px 4px #0001;display:flex;flex-direction:column;gap:4px}
.ic{font-size:44px;text-align:center}.pr{font-weight:700;color:#1e3a8a}
.chip{background:#e0e7ff;color:#1e3a8a;margin:2px}.chip.on{background:#1e3a8a;color:#fff}
.muted{color:#6b7280}.err{color:#dc2626}.ok{color:#16a34a}
.toast{position:fixed;bottom:20px;right:20px;background:#111827;color:#fff;padding:10px 16px;border-radius:8px;z-index:9}
.stat{display:inline-block;background:#eef2ff;border-radius:8px;padding:10px 18px;margin:4px;text-align:center}.stat b{display:block;font-size:22px}
iframe{width:100%;height:280px;border:0;border-radius:8px}
</code></pre>
        </div>

        <div class="sub-sec">
            <h4>6. SOURCE CODE: JAVASCRIPT (script.js)</h4>
            <pre><code>/* Shared helpers: DOM, localStorage &quot;database&quot;, authentication, role-based menus */
const $=(s,e=document)=&gt;e.querySelector(s),$$=(s,e=document)=&gt;[...e.querySelectorAll(s)];
const DB={get(k,d){try{const v=JSON.parse(localStorage.getItem(k));return v??d}catch{return d}},set(k,v){localStorage.setItem(k,JSON.stringify(v))}};
const uid=()=&gt;Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const esc=s=&gt;String(s??&#x27;&#x27;).replace(/[&amp;&lt;&gt;&quot;&#x27;]/g,c=&gt;({&#x27;&amp;&#x27;:&#x27;&amp;amp;&#x27;,&#x27;&lt;&#x27;:&#x27;&amp;lt;&#x27;,&#x27;&gt;&#x27;:&#x27;&amp;gt;&#x27;,&#x27;&quot;&#x27;:&#x27;&amp;quot;&#x27;,&quot;&#x27;&quot;:&#x27;&amp;#39;&#x27;}[c]));
const inr=n=&gt;&#x27;₹&#x27;+Number(n).toLocaleString(&#x27;en-IN&#x27;);
const today=()=&gt;new Date().toISOString().slice(0,10);
const addM=(d,m)=&gt;{const x=new Date(d);x.setMonth(x.getMonth()+m);return x.toISOString().slice(0,10)};
const view=h=&gt;{$(&#x27;#app&#x27;).innerHTML=h};
const go=i=&gt;$$(&#x27;#nav button&#x27;)[i].click();
const toast=m=&gt;{const t=document.createElement(&#x27;div&#x27;);t.className=&#x27;toast&#x27;;t.textContent=m;document.body.append(t);setTimeout(()=&gt;t.remove(),2300)};
const opts=(a,sel)=&gt;a.map(x=&gt;`&lt;option${x==sel?&#x27; selected&#x27;:&#x27;&#x27;}&gt;${esc(x)}&lt;/option&gt;`).join(&#x27;&#x27;);
function table(cols,rows){if(!rows.length)return&#x27;&lt;p class=muted&gt;No records.&lt;/p&gt;&#x27;;return`&lt;div class=tw&gt;&lt;table&gt;&lt;tr&gt;${cols.map(c=&gt;`&lt;th&gt;${c[0]}&lt;/th&gt;`).join(&#x27;&#x27;)}&lt;/tr&gt;${rows.map(r=&gt;`&lt;tr&gt;${cols.map(c=&gt;`&lt;td&gt;${c[1](r)}&lt;/td&gt;`).join(&#x27;&#x27;)}&lt;/tr&gt;`).join(&#x27;&#x27;)}&lt;/table&gt;&lt;/div&gt;`}
function onForm(sel,fn){const f=$(sel);f.onsubmit=e=&gt;{e.preventDefault();fn(Object.fromEntries(new FormData(f)),f)}}
/* Simple collection (table) stored in localStorage */
const Store=(k,seed=[])=&gt;({all(){let v=DB.get(k);if(v==null){v=seed.map(o=&gt;({id:uid(),...o}));DB.set(k,v)}return v},save(v){DB.set(k,v)},
 add(o){const v=this.all();o.id=o.id||uid();v.push(o);this.save(v);return o},upd(id,p){this.save(this.all().map(x=&gt;x.id==id?{...x,...p}:x))},
 del(id){this.save(this.all().filter(x=&gt;x.id!=id))},get(id){return this.all().find(x=&gt;x.id==id)}});
/* Authentication (demo only: passwords are stored in plain text in localStorage) */
const Auth={app:&#x27;&#x27;,init(a,seeds=[]){this.app=a;seeds.forEach(s=&gt;{if(!this.find(s.username,s.role))this.add({...s})})},
 list(){return DB.get(this.app+&#x27;:users&#x27;,[])},find(u,r){return this.list().find(x=&gt;x.username===u&amp;&amp;x.role===r)},
 add(u){const l=this.list();u.id=u.id||uid();l.push(u);DB.set(this.app+&#x27;:users&#x27;,l);return u},
 update(id,p){DB.set(this.app+&#x27;:users&#x27;,this.list().map(x=&gt;x.id===id?{...x,...p}:x))},
 remove(id){DB.set(this.app+&#x27;:users&#x27;,this.list().filter(x=&gt;x.id!==id))},
 cur(){const c=DB.get(this.app+&#x27;:cur&#x27;);return c?this.list().find(x=&gt;x.id===c)||null:null},
 login(u,p,r){const x=this.find(u,r);if(!x||x.password!==p)return&#x27;Invalid username or password&#x27;;if(x.approved===false)return&#x27;Account is waiting for admin approval&#x27;;DB.set(this.app+&#x27;:cur&#x27;,x.id)},
 logout(){localStorage.removeItem(this.app+&#x27;:cur&#x27;)}};
function loginUI(cfg){
 view(`&lt;div class=card style=&quot;max-width:380px;margin:30px auto&quot;&gt;&lt;h2 id=lt&gt;Login&lt;/h2&gt;&lt;form id=f&gt;&lt;label&gt;Role&lt;select name=role&gt;${cfg.roles.map(r=&gt;`&lt;option value=${r.id}&gt;${r.label}&lt;/option&gt;`).join(&#x27;&#x27;)}&lt;/select&gt;&lt;/label&gt;&lt;div id=extra&gt;&lt;/div&gt;&lt;label&gt;Username&lt;input name=username required&gt;&lt;/label&gt;&lt;label&gt;Password&lt;input name=password type=password required&gt;&lt;/label&gt;&lt;button&gt;Login&lt;/button&gt;&lt;/form&gt;&lt;p id=sw class=muted&gt;&lt;/p&gt;&lt;p id=msg class=err&gt;&lt;/p&gt;&lt;/div&gt;`);
 let mode=&#x27;login&#x27;;const f=$(&#x27;#f&#x27;),el=f.elements;
 const sync=()=&gt;{const r=cfg.roles.find(x=&gt;x.id===el.role.value);if(!r.reg)mode=&#x27;login&#x27;;
  $(&#x27;#extra&#x27;).innerHTML=mode==&#x27;reg&#x27;?&#x27;&lt;label&gt;Full name&lt;input name=name required&gt;&lt;/label&gt;&lt;label&gt;Phone&lt;input name=phone&gt;&lt;/label&gt;&#x27;:&#x27;&#x27;;
  f.querySelector(&#x27;button&#x27;).textContent=$(&#x27;#lt&#x27;).textContent=mode==&#x27;reg&#x27;?&#x27;Register&#x27;:&#x27;Login&#x27;;
  $(&#x27;#sw&#x27;).innerHTML=(r.reg?`&lt;a href=# id=tg&gt;${mode==&#x27;reg&#x27;?&#x27;Have an account? Login&#x27;:&#x27;New user? Register&#x27;}&lt;/a&gt;&lt;br&gt;`:&#x27;&#x27;)+(cfg.hint||&#x27;&#x27;);
  const tg=$(&#x27;#tg&#x27;);if(tg)tg.onclick=e=&gt;{e.preventDefault();mode=mode==&#x27;reg&#x27;?&#x27;login&#x27;:&#x27;reg&#x27;;sync()}};
 el.role.onchange=sync;sync();
 f.onsubmit=e=&gt;{e.preventDefault();const d=Object.fromEntries(new FormData(f)),r=cfg.roles.find(x=&gt;x.id==d.role);
  if(mode==&#x27;reg&#x27;){if(Auth.find(d.username,d.role))return $(&#x27;#msg&#x27;).textContent=&#x27;Username already taken&#x27;;
   Auth.add({...d,...(r.approval?{approved:false}:{})});if(r.approval){mode=&#x27;login&#x27;;sync();return $(&#x27;#msg&#x27;).textContent=&#x27;Registered. Please wait for admin approval, then login.&#x27;}}
  const m=Auth.login(d.username,d.password,d.role);if(m)return $(&#x27;#msg&#x27;).textContent=m;boot(cfg)}}
function boot(cfg){
 Auth.init(cfg.app,cfg.seed);document.title=cfg.title;
 document.body.innerHTML=`&lt;header&gt;&lt;h1&gt;${cfg.title}&lt;/h1&gt;&lt;nav id=nav&gt;&lt;/nav&gt;&lt;span id=who&gt;&lt;/span&gt;&lt;/header&gt;&lt;main id=app&gt;&lt;/main&gt;`;
 const u=Auth.cur();if(!u)return loginUI(cfg);
 $(&#x27;#who&#x27;).innerHTML=`${esc(u.name||u.username)} · ${u.role} &lt;button id=lo&gt;Logout&lt;/button&gt;`;$(&#x27;#lo&#x27;).onclick=()=&gt;{Auth.logout();boot(cfg)};
 const items=cfg.menu[u.role](u);$(&#x27;#nav&#x27;).innerHTML=items.map(m=&gt;`&lt;button&gt;${m[0]}&lt;/button&gt;`).join(&#x27;&#x27;);
 const bs=$$(&#x27;#nav button&#x27;);bs.forEach((b,i)=&gt;b.onclick=()=&gt;{bs.forEach(x=&gt;x.classList.remove(&#x27;on&#x27;));b.classList.add(&#x27;on&#x27;);items[i][1]()});bs[0].click()}
</code></pre>
        </div>

        <div class="sub-sec">
            <h4>7. RESULT &amp; OUTPUT VERIFICATION</h4>
            <div class="result-box">
