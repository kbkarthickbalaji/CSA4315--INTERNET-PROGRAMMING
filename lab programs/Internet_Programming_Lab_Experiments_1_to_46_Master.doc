        <div class="sub-sec">
            <h4>2. AIM &amp; OBJECTIVES</h4>
            <p>To build an e-veterinary assistance portal allowing farmers and pet owners to upload livestock symptoms via video/audio/images and consult veterinary surgeons.</p>
        </div>

        <div class="sub-sec">
            <h4>3. WEB TECHNOLOGIES UTILIZED</h4>
            <p><strong>Frontend:</strong> HTML5 (Semantic Structure, Form Controls), CSS3 (Flexbox/Grid Layouts, Responsive Design), JavaScript (ES6 DOM Manipulation, Event Listeners, LocalStorage DB simulation).</p>
        </div>

        <div class="sub-sec">
            <h4>4. SOURCE CODE: HTML5 (index.html)</h4>
            <pre><code>&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
    &lt;meta charset=&quot;UTF-8&quot;&gt;
    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;
    &lt;title&gt;VetConnect - Animal Health &amp; Tele-Veterinary&lt;/title&gt;
    &lt;link rel=&quot;stylesheet&quot; href=&quot;style.css&quot;&gt;
&lt;/head&gt;
&lt;body&gt;
    &lt;header class=&quot;header&quot;&gt;
        &lt;h1&gt;🐾 Vet&lt;span&gt;Connect&lt;/span&gt;&lt;/h1&gt;
        &lt;p&gt;Rural Livestock &amp;amp; Domestic Pet Tele-Veterinary Portal&lt;/p&gt;
    &lt;/header&gt;
    &lt;main class=&quot;container&quot;&gt;
        &lt;section class=&quot;card&quot;&gt;
            &lt;h3&gt;Request Animal Tele-Consultation&lt;/h3&gt;
            &lt;form onsubmit=&quot;bookVetConsult(event)&quot;&gt;
                &lt;div class=&quot;row&quot;&gt;
                    &lt;div&gt;
                        &lt;label&gt;Animal Type *&lt;/label&gt;
                        &lt;select id=&quot;animalType&quot; required&gt;
                            &lt;option value=&quot;Dairy Cow / Cattle&quot;&gt;Dairy Cow / Cattle&lt;/option&gt;
                            &lt;option value=&quot;Buffalo&quot;&gt;Buffalo&lt;/option&gt;
                            &lt;option value=&quot;Sheep / Goat&quot;&gt;Sheep / Goat&lt;/option&gt;
                            &lt;option value=&quot;Dog / Cat&quot;&gt;Dog / Cat&lt;/option&gt;
                            &lt;option value=&quot;Poultry&quot;&gt;Poultry&lt;/option&gt;
                        &lt;/select&gt;
                    &lt;/div&gt;
                    &lt;div&gt;
                        &lt;label&gt;Owner Name *&lt;/label&gt;
                        &lt;input type=&quot;text&quot; id=&quot;ownerName&quot; required placeholder=&quot;Farmer / Pet Owner&quot;&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
                &lt;div class=&quot;row&quot;&gt;
                    &lt;div&gt;
                        &lt;label&gt;Contact Phone (WhatsApp) *&lt;/label&gt;
                        &lt;input type=&quot;tel&quot; id=&quot;ownerPhone&quot; required pattern=&quot;[0-9]{10}&quot; placeholder=&quot;9876543210&quot;&gt;
                    &lt;/div&gt;
                    &lt;div&gt;
                        &lt;label&gt;Consultation Mode *&lt;/label&gt;
                        &lt;select id=&quot;consultMode&quot;&gt;
                            &lt;option value=&quot;Video Teleconsult&quot;&gt;Live Video Call&lt;/option&gt;
                            &lt;option value=&quot;Photo &amp; Symptoms Review&quot;&gt;Photo/Video Clip Upload Review&lt;/option&gt;
                            &lt;option value=&quot;Emergency Vet Dispatch&quot;&gt;Emergency Field Vet Visit&lt;/option&gt;
                        &lt;/select&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
                &lt;div&gt;
                    &lt;label&gt;Observed Signs &amp; Symptoms *&lt;/label&gt;
                    &lt;textarea id=&quot;symptomsText&quot; rows=&quot;3&quot; required placeholder=&quot;Describe reduced appetite, high temperature, limping, swelling, milk drop...&quot;&gt;&lt;/textarea&gt;
                &lt;/div&gt;
                &lt;button type=&quot;submit&quot; class=&quot;btn btn-primary&quot; style=&quot;margin-top:14px;&quot;&gt;Book Veterinary Slot &amp; Pay ₹250&lt;/button&gt;
            &lt;/form&gt;
        &lt;/section&gt;
        &lt;section class=&quot;card&quot; style=&quot;margin-top:20px;&quot;&gt;
            &lt;h3&gt;Active Veterinary Case Logs&lt;/h3&gt;
            &lt;div id=&quot;casesList&quot;&gt;&lt;/div&gt;
        &lt;/section&gt;
    &lt;/main&gt;
    &lt;div id=&quot;toast&quot; class=&quot;toast&quot;&gt;&lt;/div&gt;
    &lt;script src=&quot;script.js&quot;&gt;&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;</code></pre>
        </div>

        <div class="sub-sec">
            <h4>5. SOURCE CODE: CSS3 (style.css)</h4>
            <pre><code>* { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, sans-serif; }
body { background: #fdf4ff; color: #581c87; }
.header { background: #7e22ce; color: white; padding: 18px 6%; text-align: center; }
.header span { color: #facc15; }
.container { max-width: 860px; margin: 24px auto; padding: 0 16px; }
.card { background: white; border-radius: 10px; padding: 24px; box-shadow: 0 4px 14px rgba(0,0,0,0.06); }
.row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 12px; }
label { display: block; font-size: 0.82rem; font-weight: 700; color: #6b21a8; margin-bottom: 4px; }
input, select, textarea { width: 100%; padding: 10px; border: 1.5px solid #d8b4fe; border-radius: 6px; }
.btn { padding: 10px 20px; border: none; border-radius: 6px; font-weight: 700; cursor: pointer; }
.btn-primary { background: #7e22ce; color: white; width: 100%; }
.case-item { border-left: 4px solid #a855f7; background: #faf5ff; padding: 14px; border-radius: 6px; margin-top: 10px; }
.toast { position: fixed; bottom: 20px; right: 20px; background: #7e22ce; color: white; padding: 10px 18px; border-radius: 6px; display: none; }</code></pre>
        </div>

        <div class="sub-sec">
            <h4>6. SOURCE CODE: JAVASCRIPT (script.js)</h4>
            <pre><code>let cases = [
    { id: &#x27;VET-801&#x27;, animal: &#x27;Dairy Cow / Cattle&#x27;, owner: &#x27;Ramasamy&#x27;, phone: &#x27;9845112233&#x27;, mode: &#x27;Live Video Call&#x27;, symptoms: &#x27;Fever (103°F) and refusing fodder since yesterday morning.&#x27;, status: &#x27;Prescription Issued&#x27; }
];
function showToast(m) { const t = document.getElementById(&#x27;toast&#x27;); t.innerText = m; t.style.display = &#x27;block&#x27;; setTimeout(() =&gt; t.style.display = &#x27;none&#x27;, 2200); }
function renderCases() {
    const list = document.getElementById(&#x27;casesList&#x27;);
    list.innerHTML = cases.map(c =&gt; `
        &lt;div class=&quot;case-item&quot;&gt;
            &lt;div style=&quot;display:flex; justify-content:space-between; font-weight:700;&quot;&gt;
                &lt;span&gt;${c.id}: ${c.animal}&lt;/span&gt;
                &lt;span style=&quot;color:#7e22ce;&quot;&gt;${c.status}&lt;/span&gt;
            &lt;/div&gt;
            &lt;p style=&quot;margin:4px 0; font-size:0.88rem;&quot;&gt;&lt;strong&gt;Owner:&lt;/strong&gt; ${c.owner} (${c.phone}) | &lt;strong&gt;Mode:&lt;/strong&gt; ${c.mode}&lt;/p&gt;
            &lt;p style=&quot;font-size:0.85rem; color:#475569;&quot;&gt;&lt;strong&gt;Symptoms:&lt;/strong&gt; ${c.symptoms}&lt;/p&gt;
        &lt;/div&gt;
    `).join(&#x27;&#x27;);
}
function bookVetConsult(e) {
    e.preventDefault();
    const token = &#x27;VET-&#x27; + Math.floor(800 + Math.random() * 199);
    cases.unshift({
        id: token,
        animal: document.getElementById(&#x27;animalType&#x27;).value,
        owner: document.getElementById(&#x27;ownerName&#x27;).value.trim(),
        phone: document.getElementById(&#x27;ownerPhone&#x27;).value.trim(),
        mode: document.getElementById(&#x27;consultMode&#x27;).value,
        symptoms: document.getElementById(&#x27;symptomsText&#x27;).value.trim(),
        status: &#x27;Doctor Assigned&#x27;
    });
    showToast(`Consultation confirmed! Case ID: ${token}`);
    e.target.reset();
    renderCases();
}
window.addEventListener(&#x27;DOMContentLoaded&#x27;, renderCases);</code></pre>
        </div>

        <div class="sub-sec">
