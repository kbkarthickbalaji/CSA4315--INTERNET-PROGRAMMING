            <h4>4. SOURCE CODE: HTML5 (index.html)</h4>
            <pre><code>&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;&lt;head&gt;&lt;meta charset=&quot;UTF-8&quot;&gt;&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&lt;title&gt;Online Cake Ordering&lt;/title&gt;&lt;link rel=&quot;stylesheet&quot; href=&quot;style.css&quot;&gt;&lt;/head&gt;
&lt;body&gt;&lt;header&gt;&lt;h1&gt;Online Cake Ordering&lt;/h1&gt;&lt;p&gt;Browse cakes by category/flavour/occasion, customize size and message, add to cart, enter delivery address, place demo order and track status.&lt;/p&gt;&lt;nav&gt;&lt;a href=&quot;#features&quot;&gt;Features&lt;/a&gt;&lt;a href=&quot;#main&quot;&gt;Explore / Book&lt;/a&gt;&lt;a href=&quot;#records&quot;&gt;My dashboard&lt;/a&gt;&lt;a href=&quot;#admin&quot;&gt;Admin demo&lt;/a&gt;&lt;/nav&gt;&lt;/header&gt;
&lt;main&gt;&lt;div class=&quot;hero&quot;&gt;&lt;h2&gt;Welcome&lt;/h2&gt;&lt;p&gt;This is a responsive front-end lab demonstration based on Experiment 06. Use the forms to try the workflow.&lt;/p&gt;&lt;span class=&quot;tag&quot;&gt;HTML · CSS · JavaScript&lt;/span&gt;&lt;/div&gt;
&lt;section id=&quot;features&quot;&gt;&lt;h2&gt;Key features&lt;/h2&gt;&lt;div class=&quot;grid&quot;&gt;&lt;article class=&quot;card&quot;&gt;&lt;h3&gt;Cake catalogue&lt;/h3&gt;&lt;p class=&quot;muted&quot;&gt;Filter sample cakes and view descriptions and prices.&lt;/p&gt;&lt;/article&gt;&lt;article class=&quot;card&quot;&gt;&lt;h3&gt;Cart and checkout&lt;/h3&gt;&lt;p class=&quot;muted&quot;&gt;Customize cake size/message and place a demo order.&lt;/p&gt;&lt;/article&gt;&lt;article class=&quot;card&quot;&gt;&lt;h3&gt;Admin panel&lt;/h3&gt;&lt;p class=&quot;muted&quot;&gt;Add cake products and update sample order status.&lt;/p&gt;&lt;/article&gt;&lt;/div&gt;&lt;/section&gt;
&lt;div id=&quot;main&quot; style=&quot;display:grid;gap:16px;margin-top:20px&quot;&gt;
&lt;section class=&quot;panel&quot;&gt;&lt;h2&gt;Cake catalogue&lt;/h2&gt;&lt;div class=&quot;grid&quot;&gt;&lt;div&gt;&lt;label&gt;Category&lt;/label&gt;&lt;select id=&quot;category&quot;&gt;&lt;option&gt;All&lt;/option&gt;&lt;option&gt;Birthday&lt;/option&gt;&lt;option&gt;Wedding&lt;/option&gt;&lt;option&gt;Chocolate&lt;/option&gt;&lt;/select&gt;&lt;/div&gt;&lt;div&gt;&lt;label&gt;Search cake&lt;/label&gt;&lt;input id=&quot;cakeSearch&quot; placeholder=&quot;Cake name&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div id=&quot;cakeList&quot;&gt;&lt;/div&gt;&lt;/section&gt;
&lt;section class=&quot;panel&quot;&gt;&lt;h2&gt;Customize and order&lt;/h2&gt;&lt;form id=&quot;demoForm&quot;&gt;&lt;label&gt;Cake / size&lt;/label&gt;&lt;input name=&quot;title&quot; required placeholder=&quot;Chocolate truffle - 1 kg&quot;&gt;&lt;label&gt;Message and delivery address&lt;/label&gt;&lt;textarea name=&quot;detail&quot; required placeholder=&quot;Happy Birthday! Delivery address...&quot;&gt;&lt;/textarea&gt;&lt;input type=&quot;hidden&quot; name=&quot;status&quot; value=&quot;Order placed (demo)&quot;&gt;&lt;button&gt;Place demo order&lt;/button&gt;&lt;/form&gt;&lt;/section&gt;&lt;/div&gt;
&lt;section id=&quot;records&quot; class=&quot;panel&quot; style=&quot;margin-top:18px&quot;&gt;&lt;h2&gt;My dashboard / saved records&lt;/h2&gt;&lt;div id=&quot;records&quot;&gt;&lt;/div&gt;&lt;div class=&quot;actions&quot;&gt;&lt;button class=&quot;secondary&quot; onclick=&quot;resetDemo()&quot;&gt;Clear demo data&lt;/button&gt;&lt;/div&gt;&lt;/section&gt;
&lt;section id=&quot;admin&quot; class=&quot;panel&quot; style=&quot;margin-top:18px&quot;&gt;&lt;h2&gt;Admin panel (front-end demo)&lt;/h2&gt;&lt;p class=&quot;muted&quot;&gt;Administrative changes below are stored only in this browser. No real account or server is connected.&lt;/p&gt;&lt;form id=&quot;adminForm&quot;&gt;&lt;label&gt;Item / setting&lt;/label&gt;&lt;input name=&quot;title&quot; required placeholder=&quot;Service, room, bus, product, schedule...&quot;&gt;&lt;label&gt;Details / updated value&lt;/label&gt;&lt;input name=&quot;detail&quot; required placeholder=&quot;Enter details&quot;&gt;&lt;input type=&quot;hidden&quot; name=&quot;status&quot; value=&quot;Admin update&quot;&gt;&lt;button&gt;Save admin update&lt;/button&gt;&lt;/form&gt;&lt;/section&gt;
&lt;div id=&quot;message&quot;&gt;&lt;/div&gt;&lt;div class=&quot;notice warning&quot;&gt;&lt;strong&gt;Important:&lt;/strong&gt; This is a client-side academic demonstration. Real authentication, database storage, live inventory, payment gateway, email/SMS notifications and production security require a server and trusted service integrations. Do not enter real passwords or payment details.&lt;/div&gt;
&lt;/main&gt;&lt;footer&gt;Internet Programming Lab · Experiment 06 · Responsive HTML/CSS/JavaScript demo&lt;/footer&gt;&lt;script src=&quot;script.js&quot;&gt;&lt;/script&gt;&lt;/body&gt;&lt;/html&gt;</code></pre>
