        </div>

        <div class="sub-sec">
            <h4>5. SOURCE CODE: CSS3 (style.css)</h4>
            <pre><code>* { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, sans-serif; }
body { background: #f0fdfa; color: #134e4a; }
.header { background: #0f766e; color: white; padding: 18px 6%; text-align: center; }
.header span { color: #5eead4; }
.container { max-width: 960px; margin: 24px auto; padding: 0 16px; }
.tour-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px; }
.tour-card { background: white; border-radius: 8px; padding: 18px; border: 1px solid #ccfbf1; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
.tour-dur { color: #0d9488; font-weight: 700; font-size: 0.8rem; }
.tour-price { font-size: 1.25rem; font-weight: 800; color: #115e59; margin: 10px 0; }
.btn { width: 100%; padding: 10px; background: #0f766e; color: white; border: none; border-radius: 6px; font-weight: 700; cursor: pointer; }
.toast { position: fixed; bottom: 20px; right: 20px; background: #0f766e; color: white; padding: 10px 18px; border-radius: 6px; display: none; }</code></pre>
        </div>

        <div class="sub-sec">
            <h4>6. SOURCE CODE: JAVASCRIPT (script.js)</h4>
            <pre><code>const packages = [
    { id: 1, title: &#x27;Mystical Manali &amp; Rohtang Pass&#x27;, dur: &#x27;5 Days / 4 Nights&#x27;, price: 14500, incl: &#x27;Resort Stay, Paragliding, Meals&#x27; },
    { id: 2, title: &#x27;Kerala Backwaters &amp; Munnar Hills&#x27;, dur: &#x27;4 Days / 3 Nights&#x27;, price: 12900, incl: &#x27;Houseboat Cruise, Tea Plantation Tour&#x27; },
    { id: 3, title: &#x27;Golden Triangle: Delhi, Agra &amp; Jaipur&#x27;, dur: &#x27;6 Days / 5 Nights&#x27;, price: 18500, incl: &#x27;Taj Mahal Guided Entry, Heritage Palace&#x27; }
];
function showToast(m) { const t = document.getElementById(&#x27;toast&#x27;); t.innerText = m; t.style.display = &#x27;block&#x27;; setTimeout(() =&gt; t.style.display = &#x27;none&#x27;, 2500); }
function renderPackages() {
    document.getElementById(&#x27;tourGrid&#x27;).innerHTML = packages.map(p =&gt; `
        &lt;div class=&quot;tour-card&quot;&gt;
            &lt;span class=&quot;tour-dur&quot;&gt;${p.dur}&lt;/span&gt;
            &lt;h3&gt;${p.title}&lt;/h3&gt;
            &lt;p style=&quot;font-size:0.85rem; color:#64748b; margin:6px 0;&quot;&gt;Includes: ${p.incl}&lt;/p&gt;
            &lt;div class=&quot;tour-price&quot;&gt;₹${p.price.toLocaleString(&#x27;en-IN&#x27;)} &lt;small style=&quot;font-size:0.75rem; font-weight:normal;&quot;&gt;/ person&lt;/small&gt;&lt;/div&gt;
            &lt;button class=&quot;btn&quot; onclick=&quot;bookTour(&#x27;${p.title}&#x27;)&quot;&gt;Book Holiday Package&lt;/button&gt;
        &lt;/div&gt;
    `).join(&#x27;&#x27;);
}
function bookTour(t) { showToast(`✓ Booking initialized for ${t}! Executive will call with flight schedule.`); }
window.addEventListener(&#x27;DOMContentLoaded&#x27;, renderPackages);</code></pre>
        </div>

        <div class="sub-sec">
