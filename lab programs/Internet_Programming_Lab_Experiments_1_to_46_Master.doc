        &lt;div id=&quot;tourGrid&quot; class=&quot;tour-grid&quot;&gt;&lt;/div&gt;
    &lt;/main&gt;
    &lt;div id=&quot;toast&quot; class=&quot;toast&quot;&gt;&lt;/div&gt;
