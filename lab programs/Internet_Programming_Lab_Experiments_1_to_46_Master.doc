    <section id="exp_12" class="exp-section">
        <div class="exp-header">
            <h2>EXPERIMENT 12: INSUREEASY ONLINE INSURANCE MANAGEMENT</h2>
        </div>

        <div class="sub-sec">
            <h4>1. PROBLEM STATEMENT (QUESTION)</h4>
            <div class="question-box">12. InsureEasy, a cutting-edge online insurance management platform, is designed to 

streamline the insurance process for users. The website allows customers to easily 

compare and purchase various insurance policies, including health, auto, and home 

insurance. Key functionalities include user registration and login, a policy comparison 

tool, detailed policy descriptions, and secure online applications. Users can view and 

manage their existing policies, make premium payments, and file claims through an 

intuitive dashboard. The platform also provides personalized recommendations based on 

user profiles and needs, and sends automated reminders for policy renewals and 

upcoming payments. InsureEasy aims to enhance user convenience and provide 

comprehensive support for all insurance-related needs.This system maintains 

information of managers who can deal with agents and customers. In existing system, the 

manual procedure is followed where records are used to maintain data which is a time 

taking process and requires manpower and calculating commissions dues. Etc are done 

manually. This system is where agents send SMS alerts to the policyholder to remind them 

before and exceed the data of due.

Admin

• Login

• Approve Agent login

• View all agent details

Agents

• Register

• Login

• Create Customer

• Manager Customer Details

• Manage Policy Details

• Send SMS Alert

User

• Login

• Manage policy details

• Get sms alert</div>
        </div>

        <div class="sub-sec">
            <h4>2. AIM &amp; OBJECTIVES</h4>
            <p>To design, develop and test a responsive web-based insureeasy online insurance management utilizing HTML5, CSS3, and JavaScript.</p>
        </div>

        <div class="sub-sec">
            <h4>3. WEB TECHNOLOGIES UTILIZED</h4>
            <p><strong>Frontend:</strong> HTML5 (Semantic Structure, Form Controls), CSS3 (Flexbox/Grid Layouts, Responsive Design), JavaScript (ES6 DOM Manipulation, Event Listeners, LocalStorage DB simulation).</p>
        </div>

        <div class="sub-sec">
            <h4>4. SOURCE CODE: HTML5 (index.html)</h4>
            <pre><code>&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset=utf-8&gt;&lt;meta name=viewport content=&quot;width=device-width,initial-scale=1&quot;&gt;&lt;link rel=stylesheet href=../style.css&gt;&lt;/head&gt;&lt;body&gt;&lt;script src=../common.js&gt;&lt;/script&gt;&lt;script&gt;
const POL=Store(&#x27;ie:policies&#x27;,[]),AL=Store(&#x27;ie:alerts&#x27;,[]);let U;
const cust=()=&gt;Auth.list().filter(u=&gt;u.role==&#x27;user&#x27;&amp;&amp;u.agentId==U.id),nm=id=&gt;Auth.list().find(u=&gt;u.id==id)?.name||&#x27;?&#x27;;
const soon=()=&gt;{const d=new Date();d.setDate(d.getDate()+7);return d.toISOString().slice(0,10)};
const myPol=()=&gt;POL.all().filter(p=&gt;p.agentId==U.id);
const msg=p=&gt;`Dear ${nm(p.userId)}, your ${p.plan} premium of ${inr(p.premium)} ${p.dueDate&lt;today()?&#x27;was due on&#x27;:&#x27;is due on&#x27;} ${p.dueDate}. Please pay to keep your policy active. - InsureEasy`;
function aAgents(){view(`&lt;div class=card&gt;&lt;h2&gt;Agents&lt;/h2&gt;${table([[&#x27;Name&#x27;,a=&gt;esc(a.name)],[&#x27;Username&#x27;,a=&gt;esc(a.username)],[&#x27;Phone&#x27;,a=&gt;esc(a.phone||&#x27;-&#x27;)],[&#x27;Customers&#x27;,a=&gt;Auth.list().filter(u=&gt;u.agentId==a.id).length],[&#x27;Policies&#x27;,a=&gt;POL.all().filter(p=&gt;p.agentId==a.id).length],[&#x27;Status&#x27;,a=&gt;a.approved===false?&#x27;&lt;b class=err&gt;Pending&lt;/b&gt;&#x27;:&#x27;&lt;b class=ok&gt;Approved&lt;/b&gt;&#x27;],[&#x27;&#x27;,a=&gt;a.approved===false?`&lt;button onclick=&quot;S.ap(&#x27;${a.id}&#x27;,true)&quot;&gt;Approve&lt;/button&gt;`:`&lt;button onclick=&quot;S.ap(&#x27;${a.id}&#x27;,false)&quot;&gt;Revoke&lt;/button&gt;`]],Auth.list().filter(u=&gt;u.role==&#x27;agent&#x27;))}&lt;/div&gt;`)}
function customers(){view(`&lt;div class=card&gt;&lt;h2&gt;Create customer&lt;/h2&gt;&lt;form id=f class=grid&gt;&lt;label&gt;Name&lt;input name=name required&gt;&lt;/label&gt;&lt;label&gt;Username&lt;input name=username required&gt;&lt;/label&gt;&lt;label&gt;Password&lt;input name=password required&gt;&lt;/label&gt;&lt;label&gt;Phone&lt;input name=phone required&gt;&lt;/label&gt;&lt;label&gt;Email&lt;input type=email name=email&gt;&lt;/label&gt;&lt;button&gt;Create&lt;/button&gt;&lt;/form&gt;&lt;/div&gt;&lt;div class=card&gt;&lt;h2&gt;My customers&lt;/h2&gt;${table([[&#x27;Name&#x27;,u=&gt;esc(u.name)],[&#x27;Username&#x27;,u=&gt;esc(u.username)],[&#x27;Phone&#x27;,u=&gt;esc(u.phone)],[&#x27;Email&#x27;,u=&gt;esc(u.email||&#x27;-&#x27;)],[&#x27;&#x27;,u=&gt;`&lt;button onclick=&quot;S.edit(&#x27;${u.id}&#x27;)&quot;&gt;Edit&lt;/button&gt; &lt;button onclick=&quot;S.delC(&#x27;${u.id}&#x27;)&quot;&gt;Delete&lt;/button&gt;`]],cust())}&lt;/div&gt;`);
 onForm(&#x27;#f&#x27;,v=&gt;{if(Auth.find(v.username,&#x27;user&#x27;))return toast(&#x27;Username taken&#x27;);Auth.add({...v,role:&#x27;user&#x27;,agentId:U.id});customers()})}
function policies(){view(`&lt;div class=card&gt;&lt;h2&gt;Add policy&lt;/h2&gt;${cust().length?`&lt;form id=f class=grid&gt;&lt;label&gt;Customer&lt;select name=userId&gt;${cust().map(u=&gt;`&lt;option value=${u.id}&gt;${esc(u.name)}&lt;/option&gt;`).join(&#x27;&#x27;)}&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Type&lt;select name=type&gt;${opts([&#x27;Health&#x27;,&#x27;Auto&#x27;,&#x27;Home&#x27;])}&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Plan name&lt;input name=plan required&gt;&lt;/label&gt;&lt;label&gt;Premium (₹)&lt;input type=number name=premium required&gt;&lt;/label&gt;&lt;label&gt;Frequency&lt;select name=freq&gt;${opts([&#x27;Monthly&#x27;,&#x27;Yearly&#x27;])}&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Next due date&lt;input type=date name=dueDate required&gt;&lt;/label&gt;&lt;button&gt;Add&lt;/button&gt;&lt;/form&gt;`:&#x27;&lt;p&gt;Create a customer first.&lt;/p&gt;&#x27;}&lt;/div&gt;&lt;div class=card&gt;&lt;h2&gt;Policies&lt;/h2&gt;${table([[&#x27;Customer&#x27;,p=&gt;esc(nm(p.userId))],[&#x27;Type&#x27;,p=&gt;p.type],[&#x27;Plan&#x27;,p=&gt;esc(p.plan)],[&#x27;Premium&#x27;,p=&gt;inr(p.premium)+&#x27; / &#x27;+p.freq],[&#x27;Due&#x27;,p=&gt;p.dueDate],[&#x27;&#x27;,p=&gt;`&lt;button onclick=&quot;S.pe(&#x27;${p.id}&#x27;)&quot;&gt;Edit premium&lt;/button&gt; &lt;button onclick=&quot;S.delP(&#x27;${p.id}&#x27;)&quot;&gt;Delete&lt;/button&gt;`]],myPol())}&lt;/div&gt;`);
 if(cust().length)onForm(&#x27;#f&#x27;,v=&gt;{POL.add({...v,premium:+v.premium,agentId:U.id});policies()})}
function alerts(){const due=myPol().filter(p=&gt;p.dueDate&lt;=soon());view(`&lt;div class=card&gt;&lt;h2&gt;Premiums due in 7 days / overdue&lt;/h2&gt;${table([[&#x27;Customer&#x27;,p=&gt;esc(nm(p.userId))],[&#x27;Plan&#x27;,p=&gt;esc(p.plan)],[&#x27;Due&#x27;,p=&gt;p.dueDate&lt;today()?`&lt;b class=err&gt;${p.dueDate} (overdue)&lt;/b&gt;`:p.dueDate],[&#x27;&#x27;,p=&gt;`&lt;button onclick=&quot;S.sms(&#x27;${p.id}&#x27;)&quot;&gt;Send SMS alert&lt;/button&gt;`]],due)}${due.length?&#x27;&lt;p&gt;&lt;button onclick=&quot;S.smsAll()&quot;&gt;Send to all&lt;/button&gt;&lt;/p&gt;&#x27;:&#x27;&#x27;}&lt;/div&gt;&lt;div class=card&gt;&lt;h2&gt;SMS sent&lt;/h2&gt;${table([[&#x27;Time&#x27;,a=&gt;esc(a.date)],[&#x27;To&#x27;,a=&gt;esc(nm(a.userId))],[&#x27;Message&#x27;,a=&gt;esc(a.msg)]],AL.all().filter(a=&gt;a.agentId==U.id).reverse())}&lt;/div&gt;`)}
function mine(){view(`&lt;div class=card&gt;&lt;h2&gt;My policies&lt;/h2&gt;${table([[&#x27;Type&#x27;,p=&gt;p.type],[&#x27;Plan&#x27;,p=&gt;esc(p.plan)],[&#x27;Premium&#x27;,p=&gt;inr(p.premium)+&#x27; / &#x27;+p.freq],[&#x27;Next due&#x27;,p=&gt;p.dueDate&lt;today()?`&lt;b class=err&gt;${p.dueDate} (overdue)&lt;/b&gt;`:p.dueDate],[&#x27;Last paid&#x27;,p=&gt;p.lastPaid||&#x27;-&#x27;],[&#x27;&#x27;,p=&gt;`&lt;button onclick=&quot;S.pay(&#x27;${p.id}&#x27;)&quot;&gt;Pay premium&lt;/button&gt;`]],POL.all().filter(p=&gt;p.userId==U.id))}&lt;/div&gt;`)}
function inbox(){view(`&lt;div class=card&gt;&lt;h2&gt;SMS alerts&lt;/h2&gt;${table([[&#x27;Received&#x27;,a=&gt;esc(a.date)],[&#x27;Message&#x27;,a=&gt;esc(a.msg)]],AL.all().filter(a=&gt;a.userId==U.id).reverse())}&lt;/div&gt;`)}
const send=p=&gt;AL.add({userId:p.userId,policyId:p.id,agentId:U.id,msg:msg(p),date:new Date().toLocaleString()});
window.S={ap(id,v){Auth.update(id,{approved:v});aAgents()},
 edit(id){const u=Auth.list().find(x=&gt;x.id==id),n=prompt(&#x27;Name&#x27;,u.name),p=prompt(&#x27;Phone&#x27;,u.phone);if(n)Auth.update(id,{name:n,phone:p||u.phone});customers()},
 delC(id){if(confirm(&#x27;Delete customer and policies?&#x27;)){Auth.remove(id);POL.save(POL.all().filter(p=&gt;p.userId!=id));customers()}},
 pe(id){const v=+prompt(&#x27;New premium&#x27;,POL.get(id).premium);if(v&gt;0){POL.upd(id,{premium:v});policies()}},delP(id){POL.del(id);policies()},
 sms(id){send(POL.get(id));toast(&#x27;SMS sent&#x27;);alerts()},smsAll(){myPol().filter(p=&gt;p.dueDate&lt;=soon()).forEach(send);toast(&#x27;SMS sent to all&#x27;);alerts()},
 pay(id){const p=POL.get(id);if(confirm(&#x27;Pay &#x27;+inr(p.premium)+&#x27; now?&#x27;)){POL.upd(id,{dueDate:addM(p.dueDate,p.freq==&#x27;Monthly&#x27;?1:12),lastPaid:today()});mine()}}};
